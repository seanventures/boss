DATABASE_URL=postgresql+psycopg://boss:boss@localhost:5432/boss
OPENAI_API_KEY=
BOSS_OPENAI_MODEL=gpt-5.2-codex
BOSS_GITHUB_TOKEN=
BOSS_GITHUB_OWNER=seanheiney
BOSS_GITHUB_REPO=boss
BOSS_TARGET_GITHUB_OWNER=seanheiney
BOSS_TARGET_GITHUB_REPO=boss-sandbox
BOSS_DEFAULT_ORG_ID=org_boss
BOSS_DEFAULT_WORKSPACE_ID=ws_boss
BOSS_DEFAULT_PROJECT_ID=boss-dogfood
BOSS_ARTIFACTS_DIR=artifacts
BOSS_DAILY_CAP_USD_MICROS=10000000
BOSS_MONTHLY_CAP_USD_MICROS=200000000
