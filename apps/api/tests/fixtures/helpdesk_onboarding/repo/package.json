{
  "name": "helpdesk-ai",
  "version": "1.0.0",
  "private": true,
  "description": "HelpDesk AI: ticketing support app with OAuth/BOSS/demo login",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build": "cd web && npm install --no-audit --no-fund --loglevel=error && npm run build",
    "test": "node --import ./tests/helpers/jsxRegister.mjs --test --test-concurrency=1 tests/*.test.mjs",
    "verify": "npm test"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "connect-pg-simple": "10.0.0",
    "express": "5.2.1",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "openid-client": "6.8.8",
    "pg": "8.13.1",
    "prom-client": "15.1.3",
    "undici": "6.21.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "jsdom": "25.0.1"
  }
}
