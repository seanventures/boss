# syntax=docker/dockerfile:1.7

# Build only from a reviewed Community tree. The source export gate verifies
# that every copied path belongs in that tree before publication.
# Pin the multi-architecture base indexes reviewed for this release candidate.
# BUILD TOOLCHAINS (docs/community/TOOLCHAINS.md). Python and Node are always in the image; the
# other stacks are chosen per install: BOSS_TOOLCHAINS in .env (compose passes it here) is "none" or
# a comma-separated list of toolchains — java, go, security. The default is "java,go" (the stacks
# most people build); "none" turns both off and "security" stays opt-in. Each toolchain's
# selector below is its own stage name when the list holds it and "none" otherwise, so each
# tc-<name> stage is either that toolchain or the empty one, and BuildKit never builds a stage
# nothing uses: an install with BOSS_TOOLCHAINS=none downloads no JDK and no Go at all.
#   _TC_LIST     ",java,go,"  (commas around every name, so ",go," never matches "golang")
#   _TC_<X>_HIT  the whole list replaced by "<x>" when it holds ",<x>,", else unchanged
#   TC_<X>       "<x>", or "none" when _TC_<X>_HIT is still the list (it starts with a comma)
# String replacement in ARG values needs the dockerfile:1.7 frontend this file pins (line 1).
# An unknown name fails the build in the `toolchains` stage, in words.
ARG BOSS_TOOLCHAINS=java,go
# THE ENTERPRISE NETWORK (docs/community/ENTERPRISE_NETWORK.md). Every RUN that reaches the
# network sources scripts/install/build-network.sh (bind-mounted, never copied into an image) with
# the extra CA as the BuildKit secret `boss_build_ca` (never a layer, never `docker history`) and
# a tmpfs for the combined trust bundle. The registry mirrors and the outbound proxy are ARGs
# declared just before the step that uses them (so a change rebuilds only from there); the
# wrapper refuses one carrying a credential, because an ARG value is kept in the image history.
# There is no option to turn TLS verification off.
ARG _TC_LIST=",${BOSS_TOOLCHAINS},"
ARG _TC_JAVA_HIT=${_TC_LIST/*,java,*/java}
ARG TC_JAVA=${_TC_JAVA_HIT/,*/none}
ARG _TC_GO_HIT=${_TC_LIST/*,go,*/go}
ARG TC_GO=${_TC_GO_HIT/,*/none}
ARG _TC_SECURITY_HIT=${_TC_LIST/*,security,*/security}
ARG TC_SECURITY=${_TC_SECURITY_HIT/,*/none}

# THE SANDBOX HELPER (IDENTITY.md §7.6): the one privileged binary, built here so the runtime image
# carries no compiler. scripts/sandbox/boss-sandbox-exec.c says what it may do (and nothing more).
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS sandbox-helper
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY scripts/sandbox/boss-sandbox-exec.c /tmp/boss-sandbox-exec.c
RUN gcc -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE -pie \
      -o /tmp/boss-sandbox-exec /tmp/boss-sandbox-exec.c

FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS toolchains-none
RUN mkdir -p /opt/toolchains/bin && printf '{}\n' > /opt/toolchains/manifest.json

# JAVA: Temurin JDK 21, Maven 3.9, Gradle 8, each pinned and checked against its published
# checksum before it is unpacked. Downloaded with Python's urllib (no curl | sh). The JDK's
# jmods and src.zip are dropped (jlink is not a build-loop need); everything lands under
# /opt/toolchains/java, with java/javac/mvn/gradle linked from /opt/toolchains/bin.
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS toolchains-java
ARG TARGETARCH
ARG JDK_VERSION=21.0.12.1+1
ARG JDK_SHA256_AMD64=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
ARG JDK_SHA256_ARM64=23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
ARG GRADLE_VERSION=8.14.6
ARG GRADLE_SHA256=7988ed071b2a07900e2ec715fca15c6ab72bce6db433af301fa7fa7e9407bd24
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) arch=x64; jdk_sum="$JDK_SHA256_AMD64" ;; \
      arm64) arch=aarch64; jdk_sum="$JDK_SHA256_ARM64" ;; \
      *) echo "no Java toolchain for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    get() { python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$1" "$2"; }; \
    tag="jdk-$(printf %s "$JDK_VERSION" | sed 's/+/%2B/')"; \
    file="$(printf 'OpenJDK21U-jdk_%s_linux_hotspot_%s.tar.gz' "$arch" "$(printf %s "$JDK_VERSION" | tr + _)")"; \
    cd /tmp; \
    get "https://github.com/adoptium/temurin21-binaries/releases/download/$tag/$file" jdk.tgz; \
    echo "$jdk_sum  jdk.tgz" | sha256sum -c -; \
    get "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" maven.tgz; \
    echo "$MAVEN_SHA512  maven.tgz" | sha512sum -c -; \
    get "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" gradle.zip; \
    echo "$GRADLE_SHA256  gradle.zip" | sha256sum -c -; \
    mkdir -p /opt/toolchains/java/jdk /opt/toolchains/java/maven /opt/toolchains/bin; \
    tar -xzf jdk.tgz -C /opt/toolchains/java/jdk --strip-components=1; \
    tar -xzf maven.tgz -C /opt/toolchains/java/maven --strip-components=1; \
    python -m zipfile -e gradle.zip /tmp/gradle-x; \
    mv "/tmp/gradle-x/gradle-$GRADLE_VERSION" /opt/toolchains/java/gradle; \
    chmod 0755 /opt/toolchains/java/gradle/bin/gradle; \
    rm -rf jdk.tgz maven.tgz gradle.zip /tmp/gradle-x /opt/toolchains/java/jdk/jmods /opt/toolchains/java/jdk/lib/src.zip; \
    for b in java javac jar; do ln -s "../java/jdk/bin/$b" "/opt/toolchains/bin/$b"; done; \
    ln -s ../java/maven/bin/mvn /opt/toolchains/bin/mvn; \
    ln -s ../java/gradle/bin/gradle /opt/toolchains/bin/gradle; \
    chmod -R a+rX,go-w /opt/toolchains; \
    /opt/toolchains/bin/java -version; \
    printf '{"java": {"jdk": "Temurin %s", "maven": "%s", "gradle": "%s"}}\n' \
      "$JDK_VERSION" "$MAVEN_VERSION" "$GRADLE_VERSION" > /opt/toolchains/manifest.json

# SECURITY SCANNERS (APP_TEMPLATES_AND_SECURITY_LOOP.md §4.5): Semgrep, OSV-Scanner and OWASP ZAP,
# on top of the Java stage (ZAP needs its JRE), so BOSS_TOOLCHAINS=security carries Java too.
# Semgrep and its dependencies from a hashed lock (pip --require-hashes) into their own venv; the
# rule packs from a pinned semgrep-rules commit, selected and digest-checked by CONTENT
# (rulepack.py), so a scan never fetches a rule; OSV-Scanner and ZAP from their GitHub releases,
# each checked against its published SHA-256 before it is used.
FROM toolchains-java AS toolchains-security
ARG TARGETARCH
ARG SEMGREP_VERSION=1.180.0
ARG SEMGREP_RULES_COMMIT=9bbf021d0acffa3095fcffd17b2bc7787eb4796d
ARG SEMGREP_RULES_DIGEST=sha256:1ebc108cfc6fe7e0167c7910ade9a8c1fe4484e23ecaec451218c16e9935130e
ARG OSV_SCANNER_VERSION=2.6.0
ARG OSV_SCANNER_SHA256_AMD64=ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108
ARG OSV_SCANNER_SHA256_ARM64=2c71403eb443d05891c4f268c3ad771cf4f16e5443463fd7851ef8f454d3c7e4
ARG ZAP_VERSION=2.17.0
ARG ZAP_SHA256=efe799aaa3627db683b43f00c9c210aea0b75c00cc8f0a0f0434d12bb3ddde5a
COPY engine/boss_engine/security_scan/semgrep-requirements.lock /tmp/semgrep.lock
COPY engine/boss_engine/security_scan/rulepack.py /tmp/rulepack.py
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
ARG BOSS_PIP_INDEX_URL=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) osv_arch=amd64; osv_sum="$OSV_SCANNER_SHA256_AMD64" ;; \
      arm64) osv_arch=arm64; osv_sum="$OSV_SCANNER_SHA256_ARM64" ;; \
      *) echo "no security toolchain for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    get() { python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$1" "$2"; }; \
    sec=/opt/toolchains/security; mkdir -p "$sec"; cd /tmp; \
    python -m venv "$sec/semgrep"; \
    "$sec/semgrep/bin/pip" install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/semgrep.lock; \
    "$sec/semgrep/bin/semgrep" --version | grep -qx "$SEMGREP_VERSION"; \
    get "https://codeload.github.com/semgrep/semgrep-rules/tar.gz/$SEMGREP_RULES_COMMIT" rules.tgz; \
    mkdir rules-src; tar -xzf rules.tgz -C rules-src --strip-components=1; \
    got="$(python /tmp/rulepack.py select rules-src "$sec/semgrep-rules")"; \
    [ "$got" = "$SEMGREP_RULES_DIGEST" ] || { echo "semgrep rules digest $got != $SEMGREP_RULES_DIGEST" >&2; exit 1; }; \
    get "https://github.com/google/osv-scanner/releases/download/v$OSV_SCANNER_VERSION/osv-scanner_linux_$osv_arch" osv-scanner; \
    echo "$osv_sum  osv-scanner" | sha256sum -c -; \
    install -m 0755 osv-scanner "$sec/osv-scanner"; \
    get "https://github.com/zaproxy/zaproxy/releases/download/v$ZAP_VERSION/ZAP_${ZAP_VERSION}_Linux.tar.gz" zap.tgz; \
    echo "$ZAP_SHA256  zap.tgz" | sha256sum -c -; \
    mkdir "$sec/zap"; tar -xzf zap.tgz -C "$sec/zap" --strip-components=1; \
    rm -rf /tmp/rules.tgz /tmp/rules-src /tmp/osv-scanner /tmp/zap.tgz /tmp/semgrep.lock /tmp/rulepack.py; \
    ln -s ../security/semgrep/bin/semgrep /opt/toolchains/bin/semgrep; \
    ln -s ../security/osv-scanner /opt/toolchains/bin/osv-scanner; \
    ln -s ../security/zap/zap.sh /opt/toolchains/bin/zap.sh; \
    chmod -R a+rX,go-w /opt/toolchains; \
    /opt/toolchains/bin/osv-scanner --version; \
    python - "$SEMGREP_VERSION" "$SEMGREP_RULES_DIGEST" "$OSV_SCANNER_VERSION" "$ZAP_VERSION" <<'PY'
import json, sys
path = "/opt/toolchains/manifest.json"
manifest = json.load(open(path))
manifest["security"] = dict(zip(("semgrep", "semgrep_rules", "osv_scanner", "zap"), sys.argv[1:]))
json.dump(manifest, open(path, "w"))
PY

# GO: the official release tarball, pinned with its published SHA-256 per architecture (go.dev/dl
# and dl.google.com/go/<file>.sha256 agree), checked before it is unpacked, downloaded with
# Python's urllib. Everything lands under /opt/toolchains/go, with go and gofmt linked from
# /opt/toolchains/bin. The release's own $GOROOT/go.env (GOPROXY=…,direct, GOTOOLCHAIN=auto) is
# rewritten, so `go` is safe without any per-run environment: modules only from the Go module
# proxy (no `direct` fetch from a source host), always checked against sum.golang.org, and a
# go.mod's `toolchain` line never downloads another Go. toolchains.sandbox_env sets the same and
# more for every sandboxed run.
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS toolchains-go
ARG TARGETARCH
ARG GO_VERSION=1.27.4
ARG GO_SHA256_AMD64=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
ARG GO_SHA256_ARM64=3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) go_sum="$GO_SHA256_AMD64" ;; \
      arm64) go_sum="$GO_SHA256_ARM64" ;; \
      *) echo "no Go toolchain for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    get() { python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$1" "$2"; }; \
    cd /tmp; \
    get "https://dl.google.com/go/go$GO_VERSION.linux-${TARGETARCH:-amd64}.tar.gz" go.tgz; \
    echo "$go_sum  go.tgz" | sha256sum -c -; \
    mkdir -p /opt/toolchains/go /opt/toolchains/bin; \
    tar -xzf go.tgz -C /opt/toolchains/go --strip-components=1; \
    rm -rf go.tgz /opt/toolchains/go/api /opt/toolchains/go/test; \
    printf 'GOPROXY=https://proxy.golang.org\nGOSUMDB=sum.golang.org\nGOTOOLCHAIN=local\n' \
      > /opt/toolchains/go/go.env; \
    ln -s ../go/bin/go /opt/toolchains/bin/go; \
    ln -s ../go/bin/gofmt /opt/toolchains/bin/gofmt; \
    chmod -R a+rX,go-w /opt/toolchains; \
    /opt/toolchains/bin/go version | grep -q "go$GO_VERSION "; \
    printf '{"go": {"go": "%s"}}\n' "$GO_VERSION" > /opt/toolchains/manifest.json

# THE INSTALL'S TOOLCHAINS: every selected stage's /opt/toolchains laid over one tree (their files
# never overlap: each lives under its own directory, with its own links in bin/), and their
# manifests merged into one manifest.json. A selector that is "none" contributes an empty tree.
FROM toolchains-${TC_JAVA} AS tc-java
FROM toolchains-${TC_GO} AS tc-go
FROM toolchains-${TC_SECURITY} AS tc-security
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS toolchains
ARG BOSS_TOOLCHAINS
COPY --from=tc-java /opt/toolchains /opt/toolchains
COPY --from=tc-java /opt/toolchains/manifest.json /tmp/tc-manifests/java.json
COPY --from=tc-go /opt/toolchains /opt/toolchains
COPY --from=tc-go /opt/toolchains/manifest.json /tmp/tc-manifests/go.json
COPY --from=tc-security /opt/toolchains /opt/toolchains
COPY --from=tc-security /opt/toolchains/manifest.json /tmp/tc-manifests/security.json
RUN python - "$BOSS_TOOLCHAINS" <<'PY'
import json, pathlib, sys
known = {"none", "java", "go", "security"}
names = sys.argv[1].split(",")
bad = [n for n in names if n not in known] or (["none"] if "none" in names and len(names) > 1 else [])
if bad:
    sys.exit(f"BOSS_TOOLCHAINS={sys.argv[1]!r}: unknown or misplaced {', '.join(map(repr, bad))}. "
             "Use none, or a comma-separated list (no spaces) of: java, go, security.")
merged = {}
for f in sorted(pathlib.Path("/tmp/tc-manifests").glob("*.json")):
    merged.update(json.loads(f.read_text()))
missing = [n for n in names if n != "none" and n not in merged]
if missing:
    sys.exit(f"BOSS_TOOLCHAINS asked for {missing} and the image has {sorted(merged)}")
pathlib.Path("/opt/toolchains/manifest.json").write_text(json.dumps(merged, sort_keys=True) + "\n")
print("toolchains:", ", ".join(sorted(merged)) or "none")
PY

# THE IMAGE FAMILY (BOSSAPP-1458). Every BOSS Python service is built from ONE chain of stages,
# each adding only what the next needs, so a layer two images share is the same layer (stored
# once) and an image that needs less carries less:
#
#   python-base     Python, the runtime user, the recovery guard
#     ├─ egress           the credential proxy and the model gateway                   (slim)
#     └─ python-browser   + Playwright's headless Chromium shell (web-intel renders pages)
#          ├─ mcp-tools   the MCP servers BOSS ships                                    (slim)
#          └─ python-runtime  + Node, the coding CLIs, the C toolchain, ffmpeg, pg_dump, the
#               │              build toolchains (java,go): everything an agent run needs
#               └─ python-app -> api, worker, runner (and kg-mcp, from the worker image)
#
# Each image then takes, LAST, what changes most: BOSS's Python dependencies (`pydeps`, built in a
# stage of their own and copied in whole, so a requirements change rebuilds only that layer and the
# code, never the browser, the CLIs or the toolchains below it), the Agent SDK (`pydeps-agent`, the
# agent images only), and the code (`app-src`, assembled once). A fresh 30 GB enterprise box ran
# out of disk building the old single fat stage under every service (6.84 GB each on disk);
# scripts/install/image_budget.py holds each image to a budget.
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS python-base

COPY EXPORT_CANDIDATE_STATUS.json /tmp/community-export-status.json
RUN python -c 'import json; assert json.load(open("/tmp/community-export-status.json"))["mechanically_complete"], "Community source export is blocked"'

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/engine \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    HOME=/home/boss \
    BOSS_RUNTIME_USER=boss
WORKDIR /app

# THE RUNTIME USER, with the uid/gid every install has had (100/102): volumes made by an earlier
# release stay readable after an upgrade. /app is boss-owned, as before; the code under it is not
# group/other-writable (app-src).
RUN addgroup --system --gid 102 boss \
    && adduser --system --uid 100 --ingroup boss --home /home/boss boss \
    && mkdir -p /home/boss/.codex /home/boss/.claude /var/lib/boss/artifacts /var/lib/boss/identity \
       /var/lib/boss/sandboxes /run/boss-shim /var/lib/boss/trust /var/lib/boss/grafana-dashboards \
    && chown -R boss:boss /home/boss /var/lib/boss/artifacts /var/lib/boss/identity /var/lib/boss/sandboxes /run/boss-shim \
       /var/lib/boss/trust /var/lib/boss/grafana-dashboards /app \
    && chmod 700 /var/lib/boss/identity /home/boss && chmod 750 /var/lib/boss/artifacts \
    && chmod 711 /var/lib/boss/sandboxes /run/boss-shim && chmod 755 /var/lib/boss/trust \
    && chmod 755 /var/lib/boss/grafana-dashboards /app \
    && chmod 700 /home/boss/.codex /home/boss/.claude \
    && mkdir -p /var/lib/boss/recovery && chmod 0755 /var/lib/boss/recovery

# Non-API roles check the common hold before importing any application code. The guard (and the
# API's boss-entrypoint) then start the role through /usr/local/libexec/boss/with-extra-ca: the
# install's enterprise network (extra CA, outbound proxy) for everything the role runs.
COPY scripts/install/recovery_guard.py /usr/local/libexec/boss/recovery_guard.py
COPY scripts/install/with-extra-ca.sh /usr/local/libexec/boss/with-extra-ca
RUN chmod 0755 /usr/local/libexec/boss/recovery_guard.py /usr/local/libexec/boss/with-extra-ca
ENTRYPOINT ["python3", "/usr/local/libexec/boss/recovery_guard.py"]

# THE PINS: the requirements split three ways, each its own small file, so a stage that uses one
# rebuilds only when THAT part changes (a COPY is cached by content): the Playwright pin (the
# browser's version), the Agent SDK (the agent images only; it bundles a 250 MB Claude binary), and
# everything else (every image).
FROM python-base AS pins
COPY apps/api/requirements.txt apps/worker/requirements.txt /tmp/req/
RUN mkdir /pins && cat /tmp/req/*.txt | sed 's/[[:space:]]*#.*//' | grep -v '^[[:space:]]*$' > /tmp/all.txt \
    && grep -E '^playwright==' /tmp/all.txt > /pins/playwright.txt \
    && grep -E '^claude-agent-sdk==' /tmp/all.txt > /pins/agent.txt \
    && grep -vE '^claude-agent-sdk==' /tmp/all.txt > /pins/core.txt \
    && test "$(wc -l < /pins/playwright.txt)" = 1 && test "$(wc -l < /pins/agent.txt)" = 1

# BOSS's Python dependencies, installed under /opt/pydeps (as if it were /), copied into each image.
FROM python-base AS pydeps
COPY --from=pins /pins/core.txt /tmp/core.txt
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
ARG BOSS_PIP_INDEX_URL=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --root /opt/pydeps -r /tmp/core.txt

# The Agent SDK on top of them: pip sees the core already installed and puts only what is new
# under /opt/pydeps-agent.
FROM python-base AS pydeps-agent
COPY --from=pydeps /opt/pydeps/usr/local /usr/local
COPY --from=pins /pins/agent.txt /tmp/agent.txt
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
ARG BOSS_PIP_INDEX_URL=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && pip install --no-cache-dir --root /opt/pydeps-agent -r /tmp/agent.txt \
    && test -d /opt/pydeps-agent/usr/local/lib/python3.11/site-packages/claude_agent_sdk

# THE BROWSER: the headless shell matched to the pinned Playwright, with its system libraries.
# Only the shell: BOSS launches Chromium headless (web-intel, the console driver), and a built
# app's own Playwright tests download their browsers into the per-project cache
# (services/playwright_cache.py), never this one. The full Chromium was another 620 MB. The
# Playwright package used for the download is a throwaway venv: the image's own comes with pydeps.
FROM python-base AS python-browser
COPY --from=pins /pins/playwright.txt /tmp/playwright.txt
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
ARG BOSS_PIP_INDEX_URL=
ARG BOSS_PLAYWRIGHT_DOWNLOAD_HOST=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && python -m venv /tmp/pw \
    && /tmp/pw/bin/pip install --no-cache-dir -r /tmp/playwright.txt \
    && /tmp/pw/bin/python -m playwright install --with-deps --only-shell chromium \
    && chmod -R a+rX /opt/pw-browsers \
    && rm -rf /tmp/pw /var/lib/apt/lists/*

FROM python-browser AS python-runtime

# The official Node image supplies Node 22 and npm for coding CLIs and project
# verification. Debian's nodejs package can lag the CLI minimum Node version. 22, not 20: a
# HelpDesk build lost steps to a Node without --experimental-strip-types.
# pnpm is here too, at the web image's version: the code-task gate runs a pnpm
# workspace's verify (BOSS's own boss.verify.yaml) in THIS image, not the web one.
COPY --from=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/lib/node_modules /usr/local/lib/node_modules
# Keep the Node distribution's license alongside its binary in the API/worker image.
COPY --from=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/LICENSE /usr/local/LICENSE
# No bubblewrap/socat: no engine starts the Claude CLI's own Linux sandbox (it cannot create a
# namespace in this container). An agent session holds a model-proxy run token, never the key
# (engine/boss_engine/services/model_proxy.py). Engines declare what they exec
# (harness_registry.RuntimeBinary); test_every_engine_binary_is_in_the_image holds this stage to it.
# build-essential: a C/C++ toolchain for npm packages that compile on install (better-sqlite3,
# bcrypt: node-gyp needs make and g++). About 300 MB; agents had been told to avoid such packages
# (BOSSAPP-515, test_the_build_image_can_compile_native_modules).
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git openssh-client ffmpeg libavfilter-extra fonts-dejavu-core \
       iptables libcap2-bin curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# THE CODING CLIS AND pnpm, FROM A LOCKFILE (scripts/install/cli-lock): every package, the
# platform binaries included, is checked against the sha512 integrity committed there, so a
# registry mirror or an intercepting gateway cannot substitute a CLI that runs with model
# credentials. To change a version: edit cli-lock/package.json, then
# `npm install --package-lock-only` in that directory, and review the lockfile diff.
# npm installs the musl build of the Claude CLI beside the glibc one (the lock names no libc);
# this image is Debian (glibc), so the musl copy (about 225 MB) is removed and `claude --version`
# proves the one left runs.
COPY scripts/install/cli-lock/package.json scripts/install/cli-lock/package-lock.json /opt/boss-clis/
ARG BOSS_NPM_REGISTRY=
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && npm ci --prefix /opt/boss-clis --omit=dev --no-audit --no-fund \
    && rm -rf /opt/boss-clis/node_modules/@anthropic-ai/claude-code-linux-*-musl \
    && for b in claude codex grok pnpm pnpx; do ln -s "/opt/boss-clis/node_modules/.bin/$b" "/usr/local/bin/$b"; done \
    && for b in claude codex grok pnpm; do test -x "$(readlink -f "/usr/local/bin/$b")"; done \
    && HOME=/tmp/claude-probe claude --version >/dev/null && rm -rf /tmp/claude-probe \
    && npm cache clean --force \
    && rm -rf /root/.npm /home/boss/.npm /home/boss/.cache

# The sandbox helper: executable by the boss group only, with exactly the capabilities it needs.
# A sandbox uid (61000-61999) is never in the boss group, so it cannot run it.
COPY --from=sandbox-helper /tmp/boss-sandbox-exec /usr/local/libexec/boss/boss-sandbox-exec
COPY scripts/sandbox/entrypoint.sh /usr/local/bin/boss-entrypoint
RUN chown root:boss /usr/local/libexec/boss/boss-sandbox-exec \
    && chmod 0750 /usr/local/libexec/boss/boss-sandbox-exec \
    && setcap cap_setuid,cap_setgid,cap_chown,cap_fowner+ep /usr/local/libexec/boss/boss-sandbox-exec \
    && chmod 0755 /usr/local/bin/boss-entrypoint
# SCHEDULED SELF-BACKUPS (BOSSAPP-838, services/backup_scheduler.py): pg_dump/pg_restore of the
# SAME major version as BOSS's Postgres 16 (Debian bookworm ships 15, which refuses a 16 server),
# from the PostgreSQL project's apt repository; and the backups volume's mount point, boss-owned.
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/keyrings/pgdg.asc \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/boss/backups && chown boss:boss /var/lib/boss/backups \
    && chmod 700 /var/lib/boss/backups

# The install's build toolchains (java,go by default; empty with BOSS_TOOLCHAINS=none), on every
# process's PATH, and the per-project dependency cache the build sandbox keeps between runs
# (boss-only).
COPY --from=toolchains /opt/toolchains /opt/toolchains
ENV PATH=$PATH:/opt/toolchains/bin
# A login shell (`sh -lc`, how previews start) resets PATH from /etc/profile: put it back there too.
# /var/lib/boss/private: BOSS's shared clones, indexes and read-only imports, owner-only, so no
# sandboxed run's uid can read another project's code (services/private_dirs.py, BOSSAPP-1325).
RUN mkdir -p /var/lib/boss/toolchain-cache && chown boss:boss /var/lib/boss/toolchain-cache \
    && chmod 700 /var/lib/boss/toolchain-cache \
    && mkdir -p /var/lib/boss/repos && chown boss:boss /var/lib/boss/repos \
    && chmod 700 /var/lib/boss/repos \
    && mkdir -p /var/lib/boss/private/import /var/lib/boss/private/selfsrc \
    && chown -R boss:boss /var/lib/boss/private && chmod 700 /var/lib/boss/private \
    && printf 'PATH="$PATH:/opt/toolchains/bin"\nexport PATH\n' > /etc/profile.d/boss-toolchains.sh

# THE CODE, assembled once. These are the Community runtime directories. The reviewed export tree
# omits private modules inside shared directories; the dedicated ignore file also keeps known
# private paths out of local build contexts. Each image copies this /app whole (one layer).
FROM python-base AS app-src
COPY apps/__init__.py ./apps/__init__.py
COPY LICENSE ./LICENSE
COPY THIRD-PARTY-NOTICES.md ./THIRD-PARTY-NOTICES.md
COPY third_party/notices ./third_party/notices
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY apps/egress ./apps/egress
COPY apps/model-gateway ./apps/model-gateway
COPY apps/runner ./apps/runner
COPY api ./api
COPY db ./db
COPY engine/boss_engine ./engine/boss_engine
# AP-P4: the default verifier corpus (verifier_meta_eval.load_corpus reads /app/evals/...) and the
# recorded harness-bench baselines the governed-vs-bare API serves (harness_bench REPO_ROOT=/app).
COPY evals/verifier_meta ./evals/verifier_meta
COPY bench/harness/baselines ./bench/harness/baselines
# The built-in app templates (F2): boss_engine.templates.service.builtin_dir() finds them at
# /app/templates/apps; without this the image offers no built-in template at all.
COPY templates ./templates
# Infrastructure plugins (boss.plugin/v1): platform/registry.plugins_root() finds /app/plugins.
COPY plugins ./plugins
COPY packages/specpack ./packages/specpack
COPY scripts/metatron_tui.py ./scripts/metatron_tui.py
# Metatron's rich terminal (BOSSAPP-761): its drawing and its keyboard, beside the client, and
# the release notes its welcome panel reads "What's new" from.
COPY scripts/metatron_render.py ./scripts/metatron_render.py
COPY scripts/metatron_shell.py ./scripts/metatron_shell.py
COPY docs/community/RELEASE_NOTES_*.md ./docs/community/
COPY scripts/reliability_mcp_server.py ./scripts/reliability_mcp_server.py
COPY scripts/wait_for_postgres.py ./scripts/wait_for_postgres.py
# install.sh runs this INSIDE the api container to record the installer's machine. It was never
# copied into the image, so the step died with "can't open file" on every install — hidden until
# the node agent before it stopped failing under `sh`.
COPY scripts/install/ensure_local_place.py ./scripts/install/ensure_local_place.py
# BOSS fixes itself: the one implementation of the local-stack plan (upgrade_plan reads it), the
# same file the host self-installer runs.
COPY scripts/install/self_fix_installer.py ./scripts/install/self_fix_installer.py
COPY tools ./tools
# EVERY SOURCE FILE PARSES ON THIS IMAGE'S PYTHON. Tests run on a developer's newer Python, so
# syntax only 3.12+ accepts (an f-string spanning lines inside its braces) passed every test and
# then failed to import here, at the first step of a live run (2026-11-01). The build stops instead,
# and the installer's rollback keeps the running release.
RUN python -m compileall -q -j 0 apps engine/boss_engine tools scripts > /tmp/compileall.log 2>&1 \
    || (grep -E "Error|\*\*\*" /tmp/compileall.log | head -20; exit 1)
COPY docs/product/V1_FEATURE_LOCK.md ./docs/product/V1_FEATURE_LOCK.md
COPY docs/product/TRACEABILITY.md ./docs/product/TRACEABILITY.md
# The code a sandboxed build reads (it runs BOSS's own verify on BOSS's tree) but never writes.
RUN chown -R boss:boss /app && chmod -R go-w /app

# THE FULL IMAGE: the runtime and the code.
FROM python-runtime AS python-app
COPY --from=pydeps /opt/pydeps/usr/local /usr/local
COPY --from=pydeps-agent /opt/pydeps-agent/usr/local /usr/local
COPY --from=app-src /app /app
ARG BOSS_SOURCE_SHA=unknown
ARG BOSS_BUILT_AT=unknown
LABEL io.boss.recovery-guard="boss-recovery-hold/v1" \
    org.opencontainers.image.revision=$BOSS_SOURCE_SHA
ENV BOSS_SOURCE_SHA=$BOSS_SOURCE_SHA \
    BOSS_BUILT_AT=$BOSS_BUILT_AT
USER boss
# Fail the build if the installed browser cannot launch as the runtime user.
RUN python -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(headless=True); b.close(); p.stop()'
RUN grok --version >/dev/null
ENTRYPOINT ["python3", "/usr/local/libexec/boss/recovery_guard.py"]

FROM python-app AS api
EXPOSE 8000
# Compose runs this as root with NET_ADMIN only long enough to fence the sandbox uids' network,
# then it becomes boss for good (scripts/sandbox/entrypoint.sh). Run as boss, it just execs.
ENTRYPOINT ["/usr/local/bin/boss-entrypoint"]
# apps/api/serve.py: uvicorn, trusting forwarded headers only from BOSS_TRUSTED_PROXIES.
CMD ["python", "-m", "apps.api.serve", "--host", "0.0.0.0", "--port", "8000"]

FROM python-app AS worker
CMD ["python", "-m", "apps.worker.boss_worker.main"]

# boss-runner (BOSSAPP-828): owns coding-agent processes so a turn survives an API restart. Same
# entrypoint as the API (it fences the sandbox uids' network before becoming boss), since the
# workloads it runs are the API's sandboxed workloads. The API uses it when BOSS_RUNNER_URL is set.
FROM python-app AS runner
EXPOSE 8095
ENTRYPOINT ["/usr/local/bin/boss-entrypoint"]
CMD ["python", "-m", "apps.runner.boss_runner"]

# boss-egress (IDENTITY.md §7.10): the reverse proxy that injects per-run GitHub credentials, so a
# sandbox never holds one. Runs next to the API and as a sidecar on remote worker hosts. Needs
# DATABASE_URL, BOSS_MASTER_KEY(_FILE) and BOSS_EGRESS_SERVICE_KEY; the API sets BOSS_EGRESS_URL.
# The model gateway runs from this image too. Neither runs an agent, a build or a browser, so it
# is python-base and the code: no Node, CLIs, compilers or toolchains. It carries the install's
# toolchain MANIFEST only: egress opens a toolchain's package hosts when the install has that
# toolchain (boss_egress/connect.py toolchain_hosts), and the manifest is how it knows.
FROM python-base AS egress
COPY --from=toolchains /opt/toolchains/manifest.json /opt/toolchains/manifest.json
COPY --from=pydeps /opt/pydeps/usr/local /usr/local
COPY --from=app-src /app /app
ARG BOSS_SOURCE_SHA=unknown
ARG BOSS_BUILT_AT=unknown
LABEL io.boss.recovery-guard="boss-recovery-hold/v1" \
    org.opencontainers.image.revision=$BOSS_SOURCE_SHA
ENV BOSS_SOURCE_SHA=$BOSS_SOURCE_SHA \
    BOSS_BUILT_AT=$BOSS_BUILT_AT
USER boss
EXPOSE 8090
CMD ["python", "-m", "apps.egress.boss_egress"]

# THE MCP SERVERS BOSS SHIPS (devops-reference, web-intel, doc-render), one process, three ports.
# Every install seeds them and the cast holds them; without this service they were unreachable.
# web-intel renders pages in headless Chromium, so this is python-browser, BOSS's Python
# dependencies and the code: no Node, CLIs, compilers, toolchains or Agent SDK.
FROM python-browser AS mcp-tools
COPY --from=pydeps /opt/pydeps/usr/local /usr/local
COPY --from=app-src /app /app
ARG BOSS_SOURCE_SHA=unknown
ARG BOSS_BUILT_AT=unknown
LABEL io.boss.recovery-guard="boss-recovery-hold/v1" \
    org.opencontainers.image.revision=$BOSS_SOURCE_SHA
ENV BOSS_SOURCE_SHA=$BOSS_SOURCE_SHA \
    BOSS_BUILT_AT=$BOSS_BUILT_AT
USER boss
# Fail the build if the browser cannot launch as the runtime user.
RUN python -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(headless=True); b.close(); p.stop()'
EXPOSE 8765 8770 8771
CMD ["python", "-m", "tools.mcp_tools_mux"]

FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS web-builder
WORKDIR /app
COPY EXPORT_CANDIDATE_STATUS.json /tmp/community-export-status.json
RUN node -e 'if (!require("/tmp/community-export-status.json").mechanically_complete) throw Error("Community source export is blocked")'
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
ARG BOSS_NPM_REGISTRY=
COPY scripts/install/cli-lock/pnpm/package.json scripts/install/cli-lock/pnpm/package-lock.json /opt/boss-pnpm/
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && npm ci --prefix /opt/boss-pnpm --omit=dev --no-audit --no-fund \
    && ln -s /opt/boss-pnpm/node_modules/.bin/pnpm /usr/local/bin/pnpm && pnpm --version
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_BOSS_API_URL=
ARG NEXT_PUBLIC_BOSS_PROJECT_ID=boss-dogfood
ENV NEXT_PUBLIC_BOSS_API_URL=$NEXT_PUBLIC_BOSS_API_URL \
    NEXT_PUBLIC_BOSS_PROJECT_ID=$NEXT_PUBLIC_BOSS_PROJECT_ID
COPY apps/web ./apps/web
COPY packages/api-client ./packages/api-client
RUN test -n "$NEXT_PUBLIC_BOSS_API_URL" \
    || { echo 'NEXT_PUBLIC_BOSS_API_URL is required for the Community web build' >&2; exit 1; }
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && pnpm --filter boss-web build

FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS web
ARG NEXT_PUBLIC_BOSS_API_URL=
ARG NEXT_PUBLIC_BOSS_PROJECT_ID=boss-dogfood
# Only a host whose network/SSO already decides who gets in builds with "network"
# (lib/console-session.ts networkTrustedConsole). Empty keeps the console's own sign-in.
ARG BOSS_CONSOLE_AUTH=
ENV BOSS_CONSOLE_AUTH=${BOSS_CONSOLE_AUTH}
ENV NODE_ENV=production \
    PORT=3000 \
    NEXT_PUBLIC_BOSS_API_URL=$NEXT_PUBLIC_BOSS_API_URL \
    NEXT_PUBLIC_BOSS_PROJECT_ID=$NEXT_PUBLIC_BOSS_PROJECT_ID
WORKDIR /app
ARG BOSS_UPSTREAM_PROXY=
ARG BOSS_UPSTREAM_HTTP_PROXY=
ARG BOSS_UPSTREAM_NO_PROXY=
ARG BOSS_NPM_REGISTRY=
COPY scripts/install/cli-lock/pnpm/package.json scripts/install/cli-lock/pnpm/package-lock.json /opt/boss-pnpm/
RUN --mount=type=secret,id=boss_build_ca \
    --mount=type=bind,source=scripts/install/build-network.sh,target=/usr/local/libexec/boss-build-network \
    --mount=type=tmpfs,target=/run/boss-build-network \
    . /usr/local/libexec/boss-build-network && npm ci --prefix /opt/boss-pnpm --omit=dev --no-audit --no-fund \
    && ln -s /opt/boss-pnpm/node_modules/.bin/pnpm /usr/local/bin/pnpm && pnpm --version \
    && npm cache clean --force && rm -rf /root/.npm \
    && addgroup --system boss \
    && adduser --system --ingroup boss boss
COPY --chown=boss:boss LICENSE ./LICENSE
COPY --chown=boss:boss THIRD-PARTY-NOTICES.md ./THIRD-PARTY-NOTICES.md
COPY --chown=boss:boss third_party/notices ./third_party/notices
COPY --from=web-builder --chown=boss:boss /app/package.json ./package.json
COPY --from=web-builder --chown=boss:boss /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=web-builder --chown=boss:boss /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=web-builder --chown=boss:boss /app/node_modules ./node_modules
COPY --from=web-builder --chown=boss:boss /app/apps/web ./apps/web
COPY --from=web-builder --chown=boss:boss /app/packages/api-client ./packages/api-client
WORKDIR /app/apps/web
USER boss
EXPOSE 3000
CMD ["pnpm", "start", "-H", "0.0.0.0"]
