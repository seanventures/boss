# syntax=docker/dockerfile:1.7

# Build only from a reviewed Community tree. The source export gate verifies
# that every copied path belongs in that tree before publication.
# Pin the multi-architecture base indexes reviewed for this release candidate.
# OPT-IN TOOLCHAINS (docs/community/TOOLCHAINS.md). Python and Node are always in the image; any
# other stack is chosen per install: BOSS_TOOLCHAINS=java in .env (compose passes it here) selects
# the toolchains-java stage below. The default, "none", selects an empty one, and BuildKit never
# builds a stage nothing uses, so a default install downloads no JDK at all.
ARG BOSS_TOOLCHAINS=none

# THE SANDBOX HELPER (IDENTITY.md §7.6): the one privileged binary, built here so the runtime image
# carries no compiler. scripts/sandbox/boss-sandbox-exec.c says what it may do (and nothing more).
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS sandbox-helper
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY scripts/sandbox/boss-sandbox-exec.c /tmp/boss-sandbox-exec.c
RUN gcc -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE -pie \
      -o /tmp/boss-sandbox-exec /tmp/boss-sandbox-exec.c

FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS toolchains-none
RUN mkdir -p /opt/toolchains/bin && printf '{}\n' > /opt/toolchains/manifest.json

# JAVA: Temurin JDK 21, Maven 3.9, Gradle 8, each pinned and checked against its published
# checksum before it is unpacked. Downloaded with Python's urllib (no curl | sh). The JDK's
# jmods and src.zip are dropped (jlink is not a build-loop need); everything lands under
# /opt/toolchains/java, with java/javac/mvn/gradle linked from /opt/toolchains/bin.
FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS toolchains-java
ARG TARGETARCH
ARG JDK_VERSION=21.0.12.1+1
ARG JDK_SHA256_AMD64=ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94
ARG JDK_SHA256_ARM64=23e37e026f12f3e706f18938ff611db3032d075b09d0879a25d06718c773e223
ARG MAVEN_VERSION=3.9.16
ARG MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
ARG GRADLE_VERSION=8.14.6
ARG GRADLE_SHA256=7988ed071b2a07900e2ec715fca15c6ab72bce6db433af301fa7fa7e9407bd24
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) arch=x64; jdk_sum="$JDK_SHA256_AMD64" ;; \
      arm64) arch=aarch64; jdk_sum="$JDK_SHA256_ARM64" ;; \
      *) echo "no Java toolchain for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    get() { python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$1" "$2"; }; \
    tag="jdk-$(printf %s "$JDK_VERSION" | sed 's/+/%2B/')"; \
    file="$(printf 'OpenJDK21U-jdk_%s_linux_hotspot_%s.tar.gz' "$arch" "$(printf %s "$JDK_VERSION" | tr + _)")"; \
    cd /tmp; \
    get "https://github.com/adoptium/temurin21-binaries/releases/download/$tag/$file" jdk.tgz; \
    echo "$jdk_sum  jdk.tgz" | sha256sum -c -; \
    get "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" maven.tgz; \
    echo "$MAVEN_SHA512  maven.tgz" | sha512sum -c -; \
    get "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" gradle.zip; \
    echo "$GRADLE_SHA256  gradle.zip" | sha256sum -c -; \
    mkdir -p /opt/toolchains/java/jdk /opt/toolchains/java/maven /opt/toolchains/bin; \
    tar -xzf jdk.tgz -C /opt/toolchains/java/jdk --strip-components=1; \
    tar -xzf maven.tgz -C /opt/toolchains/java/maven --strip-components=1; \
    python -m zipfile -e gradle.zip /tmp/gradle-x; \
    mv "/tmp/gradle-x/gradle-$GRADLE_VERSION" /opt/toolchains/java/gradle; \
    chmod 0755 /opt/toolchains/java/gradle/bin/gradle; \
    rm -rf jdk.tgz maven.tgz gradle.zip /tmp/gradle-x /opt/toolchains/java/jdk/jmods /opt/toolchains/java/jdk/lib/src.zip; \
    for b in java javac jar; do ln -s "../java/jdk/bin/$b" "/opt/toolchains/bin/$b"; done; \
    ln -s ../java/maven/bin/mvn /opt/toolchains/bin/mvn; \
    ln -s ../java/gradle/bin/gradle /opt/toolchains/bin/gradle; \
    chmod -R a+rX,go-w /opt/toolchains; \
    /opt/toolchains/bin/java -version; \
    printf '{"java": {"jdk": "Temurin %s", "maven": "%s", "gradle": "%s"}}\n' \
      "$JDK_VERSION" "$MAVEN_VERSION" "$GRADLE_VERSION" > /opt/toolchains/manifest.json

# SECURITY SCANNERS (APP_TEMPLATES_AND_SECURITY_LOOP.md §4.5): Semgrep, OSV-Scanner and OWASP ZAP,
# on top of the Java stage (ZAP needs its JRE), so BOSS_TOOLCHAINS=security carries Java too.
# Semgrep and its dependencies from a hashed lock (pip --require-hashes) into their own venv; the
# rule packs from a pinned semgrep-rules commit, selected and digest-checked by CONTENT
# (rulepack.py), so a scan never fetches a rule; OSV-Scanner and ZAP from their GitHub releases,
# each checked against its published SHA-256 before it is used.
FROM toolchains-java AS toolchains-security
ARG TARGETARCH
ARG SEMGREP_VERSION=1.180.0
ARG SEMGREP_RULES_COMMIT=9bbf021d0acffa3095fcffd17b2bc7787eb4796d
ARG SEMGREP_RULES_DIGEST=sha256:1ebc108cfc6fe7e0167c7910ade9a8c1fe4484e23ecaec451218c16e9935130e
ARG OSV_SCANNER_VERSION=2.6.0
ARG OSV_SCANNER_SHA256_AMD64=ca69b3d3cd08f889a49dc0a383122f71cc528b83803671df5fd874d97485b108
ARG OSV_SCANNER_SHA256_ARM64=2c71403eb443d05891c4f268c3ad771cf4f16e5443463fd7851ef8f454d3c7e4
ARG ZAP_VERSION=2.17.0
ARG ZAP_SHA256=efe799aaa3627db683b43f00c9c210aea0b75c00cc8f0a0f0434d12bb3ddde5a
COPY engine/boss_engine/security_scan/semgrep-requirements.lock /tmp/semgrep.lock
COPY engine/boss_engine/security_scan/rulepack.py /tmp/rulepack.py
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) osv_arch=amd64; osv_sum="$OSV_SCANNER_SHA256_AMD64" ;; \
      arm64) osv_arch=arm64; osv_sum="$OSV_SCANNER_SHA256_ARM64" ;; \
      *) echo "no security toolchain for $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    get() { python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$1" "$2"; }; \
    sec=/opt/toolchains/security; mkdir -p "$sec"; cd /tmp; \
    python -m venv "$sec/semgrep"; \
    "$sec/semgrep/bin/pip" install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/semgrep.lock; \
    "$sec/semgrep/bin/semgrep" --version | grep -qx "$SEMGREP_VERSION"; \
    get "https://codeload.github.com/semgrep/semgrep-rules/tar.gz/$SEMGREP_RULES_COMMIT" rules.tgz; \
    mkdir rules-src; tar -xzf rules.tgz -C rules-src --strip-components=1; \
    got="$(python /tmp/rulepack.py select rules-src "$sec/semgrep-rules")"; \
    [ "$got" = "$SEMGREP_RULES_DIGEST" ] || { echo "semgrep rules digest $got != $SEMGREP_RULES_DIGEST" >&2; exit 1; }; \
    get "https://github.com/google/osv-scanner/releases/download/v$OSV_SCANNER_VERSION/osv-scanner_linux_$osv_arch" osv-scanner; \
    echo "$osv_sum  osv-scanner" | sha256sum -c -; \
    install -m 0755 osv-scanner "$sec/osv-scanner"; \
    get "https://github.com/zaproxy/zaproxy/releases/download/v$ZAP_VERSION/ZAP_${ZAP_VERSION}_Linux.tar.gz" zap.tgz; \
    echo "$ZAP_SHA256  zap.tgz" | sha256sum -c -; \
    mkdir "$sec/zap"; tar -xzf zap.tgz -C "$sec/zap" --strip-components=1; \
    rm -rf /tmp/rules.tgz /tmp/rules-src /tmp/osv-scanner /tmp/zap.tgz /tmp/semgrep.lock /tmp/rulepack.py; \
    ln -s ../security/semgrep/bin/semgrep /opt/toolchains/bin/semgrep; \
    ln -s ../security/osv-scanner /opt/toolchains/bin/osv-scanner; \
    ln -s ../security/zap/zap.sh /opt/toolchains/bin/zap.sh; \
    chmod -R a+rX,go-w /opt/toolchains; \
    /opt/toolchains/bin/osv-scanner --version; \
    python - "$SEMGREP_VERSION" "$SEMGREP_RULES_DIGEST" "$OSV_SCANNER_VERSION" "$ZAP_VERSION" <<'PY'
import json, sys
path = "/opt/toolchains/manifest.json"
manifest = json.load(open(path))
manifest["security"] = dict(zip(("semgrep", "semgrep_rules", "osv_scanner", "zap"), sys.argv[1:]))
json.dump(manifest, open(path, "w"))
PY

FROM toolchains-${BOSS_TOOLCHAINS} AS toolchains

FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b AS python-runtime

COPY EXPORT_CANDIDATE_STATUS.json /tmp/community-export-status.json
RUN python -c 'import json; assert json.load(open("/tmp/community-export-status.json"))["mechanically_complete"], "Community source export is blocked"'

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/engine \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    HOME=/home/boss \
    BOSS_RUNTIME_USER=boss
WORKDIR /app

# The official Node image supplies Node 22 and npm for coding CLIs and project
# verification. Debian's nodejs package can lag the CLI minimum Node version. 22, not 20: a
# HelpDesk build lost steps to a Node without --experimental-strip-types.
# pnpm is here too, at the web image's version: the code-task gate runs a pnpm
# workspace's verify (BOSS's own boss.verify.yaml) in THIS image, not the web one.
COPY --from=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/lib/node_modules /usr/local/lib/node_modules
# Keep the Node distribution's license alongside its binary in the API/worker image.
COPY --from=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 /usr/local/LICENSE /usr/local/LICENSE
# No bubblewrap/socat: no engine starts the Claude CLI's own Linux sandbox (it cannot create a
# namespace in this container). An agent session holds a model-proxy run token, never the key
# (engine/boss_engine/services/model_proxy.py). Engines declare what they exec
# (harness_registry.RuntimeBinary); test_every_engine_binary_is_in_the_image holds this stage to it.
# build-essential: a C/C++ toolchain for npm packages that compile on install (better-sqlite3,
# bcrypt: node-gyp needs make and g++). About 300 MB; agents had been told to avoid such packages
# (BOSSAPP-515, test_the_build_image_can_compile_native_modules).
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates git openssh-client ffmpeg libavfilter-extra fonts-dejavu-core \
       iptables libcap2-bin curl build-essential \
    && addgroup --system boss \
    && adduser --system --ingroup boss --home /home/boss boss \
    && mkdir -p /home/boss/.codex /home/boss/.claude /var/lib/boss/artifacts /var/lib/boss/identity \
       /var/lib/boss/sandboxes /run/boss-shim \
    && chown -R boss:boss /home/boss /var/lib/boss/artifacts /var/lib/boss/identity /var/lib/boss/sandboxes /run/boss-shim \
    && chmod 700 /var/lib/boss/identity /home/boss && chmod 750 /var/lib/boss/artifacts \
    && chmod 711 /var/lib/boss/sandboxes /run/boss-shim \
    && chmod 700 /home/boss/.codex /home/boss/.claude \
    && npm install -g @anthropic-ai/claude-code@2.1.197 @openai/codex@0.158.0 @xai-official/grok@1.0.41 \
       pnpm@9.15.0 \
    && npm cache clean --force \
    && rm -rf /home/boss/.npm /home/boss/.cache /var/lib/apt/lists/*

# The sandbox helper: executable by the boss group only, with exactly the capabilities it needs.
# A sandbox uid (61000-61999) is never in the boss group, so it cannot run it.
COPY --from=sandbox-helper /tmp/boss-sandbox-exec /usr/local/libexec/boss/boss-sandbox-exec
COPY scripts/sandbox/entrypoint.sh /usr/local/bin/boss-entrypoint
COPY scripts/install/recovery_guard.py /usr/local/libexec/boss/recovery_guard.py
RUN chown root:boss /usr/local/libexec/boss/boss-sandbox-exec \
    && chmod 0750 /usr/local/libexec/boss/boss-sandbox-exec \
    && setcap cap_setuid,cap_setgid,cap_chown,cap_fowner+ep /usr/local/libexec/boss/boss-sandbox-exec \
    && chmod 0755 /usr/local/bin/boss-entrypoint /usr/local/libexec/boss/recovery_guard.py
# Separate from identity/key state; Compose mounts this root read-only in every backend role.
RUN mkdir -p /var/lib/boss/recovery && chmod 0755 /var/lib/boss/recovery

COPY apps/api/requirements.txt /tmp/api-requirements.txt
COPY apps/worker/requirements.txt /tmp/worker-requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/api-requirements.txt -r /tmp/worker-requirements.txt

# Download the browser revision matched to the pinned Python Playwright package.
RUN python -m playwright install --with-deps chromium \
    && chmod -R a+rX /opt/pw-browsers \
    && rm -rf /var/lib/apt/lists/*

# The install's opt-in toolchains (empty unless BOSS_TOOLCHAINS names one), on every process's
# PATH, and the per-project dependency cache the build sandbox keeps between runs (boss-only).
COPY --from=toolchains /opt/toolchains /opt/toolchains
ENV PATH=$PATH:/opt/toolchains/bin
# A login shell (`sh -lc`, how previews start) resets PATH from /etc/profile: put it back there too.
RUN mkdir -p /var/lib/boss/toolchain-cache && chown boss:boss /var/lib/boss/toolchain-cache \
    && chmod 700 /var/lib/boss/toolchain-cache \
    && printf 'PATH="$PATH:/opt/toolchains/bin"\nexport PATH\n' > /etc/profile.d/boss-toolchains.sh

# These are the Community runtime directories. The reviewed export tree omits
# private modules inside shared directories; the dedicated ignore file also
# keeps known private paths out of local build contexts.
COPY apps/__init__.py ./apps/__init__.py
COPY LICENSE ./LICENSE
COPY THIRD-PARTY-NOTICES.md ./THIRD-PARTY-NOTICES.md
COPY third_party/notices ./third_party/notices
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY apps/egress ./apps/egress
COPY api ./api
COPY db ./db
COPY engine/boss_engine ./engine/boss_engine
# The built-in app templates (F2): boss_engine.templates.service.builtin_dir() finds them at
# /app/templates/apps; without this the image offers no built-in template at all.
COPY templates ./templates
# Infrastructure plugins (boss.plugin/v1): platform/registry.plugins_root() finds /app/plugins.
COPY plugins ./plugins
COPY packages/specpack ./packages/specpack
COPY scripts/metatron_tui.py ./scripts/metatron_tui.py
COPY scripts/reliability_mcp_server.py ./scripts/reliability_mcp_server.py
COPY scripts/wait_for_postgres.py ./scripts/wait_for_postgres.py
# install.sh runs this INSIDE the api container to record the installer's machine. It was never
# copied into the image, so the step died with "can't open file" on every install — hidden until
# the node agent before it stopped failing under `sh`.
COPY scripts/install/ensure_local_place.py ./scripts/install/ensure_local_place.py
# BOSS fixes itself: the one implementation of the local-stack plan (upgrade_plan reads it), the
# same file the host self-installer runs.
COPY scripts/install/self_fix_installer.py ./scripts/install/self_fix_installer.py
COPY tools ./tools
COPY docs/product/V1_FEATURE_LOCK.md ./docs/product/V1_FEATURE_LOCK.md
COPY docs/product/TRACEABILITY.md ./docs/product/TRACEABILITY.md

ARG BOSS_SOURCE_SHA=unknown
ARG BOSS_BUILT_AT=unknown
LABEL io.boss.recovery-guard="boss-recovery-hold/v1" \
    org.opencontainers.image.revision=$BOSS_SOURCE_SHA
ENV BOSS_SOURCE_SHA=$BOSS_SOURCE_SHA \
    BOSS_BUILT_AT=$BOSS_BUILT_AT
RUN chown -R boss:boss /app /var/lib/boss/artifacts /var/lib/boss/identity
# The code a sandboxed build reads (it runs BOSS's own verify on BOSS's tree) but never writes.
RUN chmod -R go-w /app
USER boss
# Fail the build if the installed browser cannot launch as the runtime user.
RUN python -c 'from playwright.sync_api import sync_playwright; p = sync_playwright().start(); b = p.chromium.launch(headless=True); b.close(); p.stop()'
RUN grok --version >/dev/null

# Non-API roles check the common hold before importing any application code.
ENTRYPOINT ["python3", "/usr/local/libexec/boss/recovery_guard.py"]

FROM python-runtime AS api
EXPOSE 8000
# Compose runs this as root with NET_ADMIN only long enough to fence the sandbox uids' network,
# then it becomes boss for good (scripts/sandbox/entrypoint.sh). Run as boss, it just execs.
ENTRYPOINT ["/usr/local/bin/boss-entrypoint"]
# apps/api/serve.py: uvicorn, trusting forwarded headers only from BOSS_TRUSTED_PROXIES.
CMD ["python", "-m", "apps.api.serve", "--host", "0.0.0.0", "--port", "8000"]

FROM python-runtime AS worker
CMD ["python", "-m", "apps.worker.boss_worker.main"]

# boss-egress (IDENTITY.md §7.10): the reverse proxy that injects per-run GitHub credentials, so a
# sandbox never holds one. Runs next to the API and as a sidecar on remote worker hosts. Needs
# DATABASE_URL, BOSS_MASTER_KEY(_FILE) and BOSS_EGRESS_SERVICE_KEY; the API sets BOSS_EGRESS_URL.
FROM python-runtime AS egress
EXPOSE 8090
CMD ["python", "-m", "apps.egress.boss_egress"]

# THE MCP SERVERS BOSS SHIPS (devops-reference, web-intel, doc-render), one process, three ports.
# Every install seeds them and the cast holds them; without this service they were unreachable.
FROM python-runtime AS mcp-tools
EXPOSE 8765 8770 8771
CMD ["python", "-m", "tools.mcp_tools_mux"]

FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS web-builder
WORKDIR /app
COPY EXPORT_CANDIDATE_STATUS.json /tmp/community-export-status.json
RUN node -e 'if (!require("/tmp/community-export-status.json").mechanically_complete) throw Error("Community source export is blocked")'
RUN npm install --global pnpm@9.15.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
RUN pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_BOSS_API_URL=
ARG NEXT_PUBLIC_BOSS_PROJECT_ID=boss-dogfood
ENV NEXT_PUBLIC_BOSS_API_URL=$NEXT_PUBLIC_BOSS_API_URL \
    NEXT_PUBLIC_BOSS_PROJECT_ID=$NEXT_PUBLIC_BOSS_PROJECT_ID
COPY apps/web ./apps/web
COPY packages/api-client ./packages/api-client
RUN test -n "$NEXT_PUBLIC_BOSS_API_URL" \
    || { echo 'NEXT_PUBLIC_BOSS_API_URL is required for the Community web build' >&2; exit 1; }
RUN pnpm --filter boss-web build

FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS web
ARG NEXT_PUBLIC_BOSS_API_URL=
ARG NEXT_PUBLIC_BOSS_PROJECT_ID=boss-dogfood
# Only a host whose network/SSO already decides who gets in builds with "network"
# (lib/console-session.ts networkTrustedConsole). Empty keeps the console's own sign-in.
ARG BOSS_CONSOLE_AUTH=
ENV BOSS_CONSOLE_AUTH=${BOSS_CONSOLE_AUTH}
ENV NODE_ENV=production \
    PORT=3000 \
    NEXT_PUBLIC_BOSS_API_URL=$NEXT_PUBLIC_BOSS_API_URL \
    NEXT_PUBLIC_BOSS_PROJECT_ID=$NEXT_PUBLIC_BOSS_PROJECT_ID
WORKDIR /app
RUN npm install --global pnpm@9.15.0 \
    && addgroup --system boss \
    && adduser --system --ingroup boss boss
COPY --chown=boss:boss LICENSE ./LICENSE
COPY --chown=boss:boss THIRD-PARTY-NOTICES.md ./THIRD-PARTY-NOTICES.md
COPY --chown=boss:boss third_party/notices ./third_party/notices
COPY --from=web-builder --chown=boss:boss /app/package.json ./package.json
COPY --from=web-builder --chown=boss:boss /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=web-builder --chown=boss:boss /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=web-builder --chown=boss:boss /app/node_modules ./node_modules
COPY --from=web-builder --chown=boss:boss /app/apps/web ./apps/web
COPY --from=web-builder --chown=boss:boss /app/packages/api-client ./packages/api-client
WORKDIR /app/apps/web
USER boss
EXPOSE 3000
CMD ["pnpm", "start", "-H", "0.0.0.0"]
