.DS_Store
.git
.github
.env
.env.*
!.env.example
app.env
# A developer's local env must never enter an image. `.env` only matches the repo root, so
# apps/web/.env.local was being copied in and loaded by the Next build — pointing the console
# at http://localhost:8000. It happened to be harmless only because the Dockerfile ENV takes
# precedence; without the build arg it would have baked a laptop address into production.
**/.env.local
**/.env.*.local
.pytest_cache
# Python's bytecode caches from a local test run: inside templates/apps they made every built-in
# with Python tests "invalid" (a binary file) in the image, so the gallery silently lost them.
**/__pycache__
**/*.pyc
.ruff_cache
.venv
artifacts
node_modules
tmp
apps/web/.next
apps/web/node_modules
packages/*/node_modules
*.log
*.zip
image.png

# Source tests remain in Git/source archives, not in production image copies.
apps/api/tests
apps/worker/tests
apps/web/tests
packages/api-client/tests
tools/tests
**/__probe_tmp

# Contributor QA utilities remain in source archives, outside production runtimes.
scripts/seed_demo.py
engine/boss_engine/identity/seed_accounts.py
engine/boss_engine/cli/console_test.py
engine/boss_engine/services/console_driver.py
engine/boss_engine/services/console_test_agent.py
engine/boss_engine/services/console_screen_check.py
