# --- use the container sandbox stand-in for code tasks (local testing) ---
BOSS_SANDBOX_PROVIDER=microvm
BOSS_SANDBOX_AGENT_URL=http://127.0.0.1:8088
BOSS_SANDBOX_GUEST_ENGINE=openai
BOSS_CODE_AGENT_ENGINE=claude_code
BOSS_CLAUDE_CLI_PATH=/Users/param/.local/bin/claude
BOSS_GOVERNED_CODING_PIPELINE=true
BOSS_CODE_REVIEW_ENGINE=
BOSS_CODE_AGENT_MAX_CONCURRENCY=4

DEEPSEEK_API_KEY=sk-3718cf4e11cc4be3958465a4433db0b3
OPENROUTER_API_KEY=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
BOSS_CLAUDE_CLI_MODEL=claude-sonnet-5
BOSS_CODE_REPAIR_MAX_RETRIES=2
BOSS_CODE_AGENT_MAX_TURNS=90
BOSS_CODE_AGENT_LOW_COST_MODEL=claude-sonnet-5
BOSS_CODE_AGENT_STRONG_MODEL=claude-opus-5
BOSS_CODE_AGENT_REVIEW_TIMEOUT_SECONDS=900

# Reviewer needs enough turns to READ a phase-sized diff AND reach a verdict. The
# default (16) was exhausted mid-review, yielding "ran out of turns — partial
# attempt" with no verdict, which fails code_review_passed and triggers a costly
# repair round even when tests pass and nothing is wrong.
BOSS_CODE_AGENT_REVIEW_MAX_TURNS=40
# Ceiling on one job holding its lease; past it the worker stops renewing so a hung
# stage is reclaimed instead of stalling for hours.
BOSS_JOB_MAX_RUNTIME_SECONDS=3600
# Deliberately EMPTY: credentials now resolve per deployment_target from a secret backend.
# Left here (rather than deleted) as the documented fallback for a target with no binding.
BOSS_SSH_HOST_PRIVATE_KEY_FILE=
BOSS_SSH_HOST_DEPLOY_ALLOWED=true
