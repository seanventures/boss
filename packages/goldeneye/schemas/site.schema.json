{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldeneye.paas/schemas/site.schema.json",
  "title": "Goldeneye site.yaml",
  "type": "object",
  "required": ["site", "network", "dns"],
  "additionalProperties": true,
  "properties": {
    "site": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["control", "edge", "apps", "data", "mixed"]
        }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "public_ip": { "type": "string" },
        "tailnet_ip": { "type": "string" },
        "tailnet_hostname": { "type": "string" },
        "operator_cidrs": { "type": "array", "items": { "type": "string" } },
        "private_cidr": { "type": "string" }
      }
    },
    "dns": {
      "type": "object",
      "properties": {
        "public_apex": { "type": "string" },
        "public_domain": { "type": "string" },
        "local_domain": { "type": "string" },
        "cloudflare_zone": { "type": "string" }
      }
    },
    "tls": { "type": "object" },
    "registry": { "type": "object" },
    "paths": { "type": "object" },
    "alerts": { "type": "object" },
    "features": { "type": "object" },
    "integrations": {
      "type": "object",
      "description": "Optional control-plane integrations (BOSS, etc.).",
      "properties": {
        "boss": {
          "type": "object",
          "properties": {
            "api_url": { "type": "string" },
            "project_id": { "type": "string" },
            "node_token_env": { "type": "string" }
          }
        }
      }
    }
  }
}
