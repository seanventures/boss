{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shared-server.paas/schemas/package.schema.json",
  "title": "Shared-server module package.yaml",
  "type": "object",
  "required": ["api_version", "id", "name", "version", "layer", "kind"],
  "additionalProperties": true,
  "properties": {
    "api_version": {
      "type": "integer",
      "const": 1,
      "description": "Module contract version. Bump only on breaking install API changes."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable module id (catalog key)."
    },
    "name": { "type": "string" },
    "version": {
      "type": "string",
      "description": "Semver of this module (independent of kit VERSION)."
    },
    "layer": { "type": "integer", "minimum": 0, "maximum": 9 },
    "kind": {
      "type": "string",
      "enum": ["host", "runtime", "edge", "control", "data", "observe", "tool", "optional", "integration"]
    },
    "description": { "type": "string" },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" }
    },
    "optional": { "type": "boolean", "default": false },
    "provides": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capability tags other modules may require."
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "install": { "type": "string", "default": "install.sh" },
        "upgrade": { "type": "string", "default": "upgrade.sh" },
        "uninstall": { "type": "string", "default": "uninstall.sh" },
        "check": { "type": "string", "default": "check.sh" }
      }
    },
    "config_schema": {
      "type": "string",
      "description": "Optional path to module-specific site config fragment schema."
    },
    "min_kit_version": {
      "type": "string",
      "description": "Minimum Shared-server kit VERSION required."
    }
  }
}
