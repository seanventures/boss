#!/usr/bin/env bash
# ge — Goldeneye operator CLI (modular package manager + deploy + node + upgrade)
set -euo pipefail

resolve_kit() {
  if [ -n "${GOLDENEYE_KIT_ROOT:-}" ]; then
    if [ -f "${GOLDENEYE_KIT_ROOT}/core/lib/common.sh" ] || [ -f "${GOLDENEYE_KIT_ROOT}/lib/common.sh" ]; then
      echo "$GOLDENEYE_KIT_ROOT"
      return
    fi
  fi
  local self cand
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P 2>/dev/null || cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # bin may be core/bin or kit/bin symlink
  for cand in \
    "$(cd "$self/../.." && pwd)" \
    "$(cd "$self/.." && pwd)" \
    /opt/goldeneye \
    ; do
    if [ -f "$cand/core/lib/common.sh" ] || [ -f "$cand/lib/common.sh" ]; then
      echo "$cand"
      return
    fi
  done
  echo "ge: cannot find kit root (set GOLDENEYE_KIT_ROOT)" >&2
  exit 1
}

KIT="$(resolve_kit)"
export GOLDENEYE_KIT_ROOT="$KIT"
if [ -f "$KIT/core/lib/common.sh" ]; then
  # shellcheck source=/dev/null
  source "$KIT/core/lib/common.sh"
  # shellcheck source=/dev/null
  source "$KIT/core/lib/module.sh"
elif [ -f "$KIT/lib/common.sh" ]; then
  # shellcheck source=/dev/null
  source "$KIT/lib/common.sh"
  # shellcheck source=/dev/null
  source "$KIT/lib/module.sh"
else
  echo "ge: missing common.sh in $KIT" >&2
  exit 1
fi

cmd_help() {
  cat <<'EOF'
ge — Goldeneye bare-metal PaaS CLI (modular kit)

Usage:
  ge help | version
  ge node status
  ge module list
  ge module install <id> [--force]
  ge module upgrade <id> [--force]
  ge module uninstall <id>
  ge module check [id]
  ge module installed
  ge pkg …                    # alias of ge module …
  ge catalog build [out.yaml]
  ge upgrade <path-to-new-kit> # self-upgrade kit + installed modules
  ge deploy <name> --image <ref> [--domain <fqdn>]
  ge deploy <name> --compose <file> [--env-template <file>]
  ge deploy <name> --rollback
  ge deploy ls | info|logs|stop|start|rm <name>
  ge status

Modules live under modules/<id>/package.yaml (see docs/MODULE_CONTRACT.md).
catalog.yaml is generated — do not hand-edit as source of truth.
EOF
}

cmd_version() {
  echo "ge ${GE_VERSION}"
  echo "kit $(ge_kit_version)"
  if [ -f "$(ge_state_dir)/kit-version" ]; then
    echo "installed $(cat "$(ge_state_dir)/kit-version")"
  fi
  echo "root $KIT"
  echo "module_api 1"
}

cmd_node_status() {
  local name public tnip
  name="$(ge_load_site_value site.name)"
  name="${name:-$(hostname -s 2>/dev/null || echo node)}"
  public="$(ge_load_site_value network.public_ip)"
  tnip="$(ge_load_site_value network.tailnet_ip)"
  if [ -z "$tnip" ] && command -v tailscale >/dev/null 2>&1; then
    tnip="$(tailscale ip -4 2>/dev/null | head -1 || true)"
  fi
  echo "node:     $name"
  echo "public:   ${public:-(unset)}"
  echo "tailnet:  ${tnip:-(unset)}"
  echo "kit:      $KIT ($(ge_kit_version))"
  echo "state:    $(ge_state_dir)"
  echo "site:     $(ge_site_file)"
  echo "docker:   $(command -v docker >/dev/null && docker --version | head -1 || echo missing)"
  echo "modules:"
  local id cur want
  local any=0
  for id in $(ge_list_module_ids); do
    ge_module_installed "$id" || continue
    any=1
    cur="$(ge_module_installed_version "$id")"
    want="$(ge_module_field "$id" version)"
    echo "  - $id@$cur (catalog $want)"
  done
  [ "$any" = "1" ] || echo "  (none)"
  if command -v docker >/dev/null 2>&1; then
    echo "networks:"
    for n in web storage ops; do
      if docker network inspect "$n" >/dev/null 2>&1; then
        echo "  - $n: present"
      else
        echo "  - $n: missing"
      fi
    done
  fi
}

cmd_module_list() {
  # rebuild catalog view if missing
  if [ ! -f "$(ge_catalog_path)" ]; then
    ge_catalog_build "$(ge_catalog_path)" >/dev/null || true
  fi
  printf '%-18s %-8s %-6s %-5s %s\n' ID VERSION LAYER INST NAME
  echo "--------------------------------------------------------------------"
  local id ver layer inst name
  for id in $(ge_list_module_ids); do
    ver="$(ge_module_field "$id" version)"
    layer="$(ge_module_field "$id" layer)"
    name="$(ge_module_field "$id" name)"
    if ge_module_installed "$id"; then
      inst="yes"
    else
      inst="no"
    fi
    local opt
    opt="$(ge_module_field "$id" optional)"
    [ "$opt" = "true" ] && name="$name (opt)"
    printf '%-18s %-8s %-6s %-5s %s\n' "$id" "${ver:--}" "${layer:--}" "$inst" "${name:--}"
  done
}

cmd_module() {
  local sub="${1:-list}"
  shift || true
  case "$sub" in
    list) cmd_module_list ;;
    installed)
      local id
      for id in $(ge_list_module_ids); do
        ge_module_installed "$id" || continue
        echo "$id $(ge_module_installed_version "$id")"
      done
      ;;
    install)
      local id="" force=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --force) force=1; shift ;;
          *) id="$1"; shift ;;
        esac
      done
      [ -n "$id" ] || ge_die "usage: ge module install <id> [--force]"
      ge_module_run_hook "$id" install "$force"
      ;;
    upgrade)
      local id="" force=0
      while [ $# -gt 0 ]; do
        case "$1" in
          --force) force=1; shift ;;
          *) id="$1"; shift ;;
        esac
      done
      [ -n "$id" ] || ge_die "usage: ge module upgrade <id> [--force]"
      ge_module_run_hook "$id" upgrade "$force"
      ;;
    uninstall|rm)
      local id="${1:-}"
      [ -n "$id" ] || ge_die "usage: ge module uninstall <id>"
      ge_require_root
      ge_module_run_hook "$id" uninstall 0
      ;;
    check)
      local id="${1:-}"
      if [ -n "$id" ]; then
        ge_module_run_hook "$id" check 0
      else
        for id in $(ge_list_module_ids); do
          ge_module_installed "$id" || continue
          ge_module_run_hook "$id" check 0 || ge_info "check failed: $id"
        done
      fi
      ;;
    *) ge_die "unknown module subcommand: $sub (list|install|upgrade|uninstall|check|installed)" ;;
  esac
}

_deploy_state_dir() {
  echo "$(ge_state_dir)/apps"
}

cmd_deploy() {
  if [ -x /usr/local/bin/deploy ] && ! grep -q 'exec ge deploy' /usr/local/bin/deploy 2>/dev/null; then
    if [ "${1:-}" != "help" ] && [ "${GE_FORCE_KIT_DEPLOY:-}" != "1" ]; then
      exec /usr/local/bin/deploy "$@"
    fi
  fi

  local sub="${1:-}"
  shift || true
  case "$sub" in
    ""|help) cat <<'EOF'
ge deploy <name> --image <ref> [--domain <fqdn>]
ge deploy <name> --compose <file> [--env-template <file>]
ge deploy <name> --rollback
ge deploy ls | info <name> | logs <name> | stop|start|rm <name>
EOF
      return 0
      ;;
    ls)
      local d
      d="$(_deploy_state_dir)"
      mkdir -p "$d"
      if [ -z "$(ls -A "$d" 2>/dev/null || true)" ]; then
        echo "(no apps recorded by kit deploy)"
        return 0
      fi
      printf '%-16s %-12s %s\n' NAME STATUS IMAGE
      for f in "$d"/*.json; do
        [ -e "$f" ] || continue
        python3 - "$f" <<'PY'
import json,sys
a=json.load(open(sys.argv[1]))
print(f"{a.get('name','?'):<16} {a.get('status','?'):<12} {a.get('image','')}")
PY
      done
      return 0
      ;;
    info|logs|stop|start|rm)
      local name="${1:-}"
      [ -n "$name" ] || ge_die "usage: ge deploy $sub <name>"
      local meta
      meta="$(_deploy_state_dir)/${name}.json"
      [ -f "$meta" ] || ge_die "unknown app: $name (not in kit state)"
      case "$sub" in
        info) cat "$meta"; echo ;;
        logs)
          command -v docker >/dev/null || ge_die "docker not available"
          docker logs --tail 100 "ge-${name}" 2>&1 || docker compose -p "$name" logs --tail 100
          ;;
        stop)
          docker stop "ge-${name}" 2>/dev/null || docker compose -p "$name" stop
          python3 -c "import json;p='$meta';a=json.load(open(p));a['status']='stopped';json.dump(a,open(p,'w'),indent=2)"
          echo "stopped $name"
          ;;
        start)
          docker start "ge-${name}" 2>/dev/null || docker compose -p "$name" start
          python3 -c "import json;p='$meta';a=json.load(open(p));a['status']='running';json.dump(a,open(p,'w'),indent=2)"
          echo "started $name"
          ;;
        rm)
          docker rm -f "ge-${name}" 2>/dev/null || true
          docker compose -p "$name" down -v 2>/dev/null || true
          rm -f "$meta"
          ge_info "removed $name"
          ;;
      esac
      return 0
      ;;
  esac

  local name="$sub"
  local image="" compose="" env_tmpl="" domain="" rollback=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --image) image="${2:-}"; shift 2 ;;
      --compose) compose="${2:-}"; shift 2 ;;
      --env-template) env_tmpl="${2:-}"; shift 2 ;;
      --domain) domain="${2:-}"; shift 2 ;;
      --rollback) rollback=1; shift ;;
      *) ge_die "unknown deploy flag: $1" ;;
    esac
  done

  ge_require_root
  mkdir -p "$(_deploy_state_dir)"
  local meta apps_root
  meta="$(_deploy_state_dir)/${name}.json"
  apps_root="$(ge_load_site_value paths.apps_root)"
  apps_root="${apps_root:-/srv/apps}"
  mkdir -p "$apps_root/$name"

  if [ "$rollback" = "1" ]; then
    [ -f "$meta" ] || ge_die "no prior deploy for $name"
    local prev
    prev="$(python3 -c "import json;print(json.load(open('$meta')).get('previous_image') or '')")"
    [ -n "$prev" ] || ge_die "no previous_image recorded for rollback"
    image="$prev"
    ge_info "rolling back $name → $image"
  fi

  if [ -n "$compose" ]; then
    [ -f "$compose" ] || ge_die "compose not found: $compose"
    cp "$compose" "$apps_root/$name/compose.yaml"
    if [ -n "$env_tmpl" ]; then
      cp "$env_tmpl" "$apps_root/$name/app.env.tmpl"
      [ -f "$apps_root/$name/.env" ] || cp "$env_tmpl" "$apps_root/$name/.env"
    fi
    ( cd "$apps_root/$name" && docker compose -p "$name" --env-file .env up -d )
    python3 - "$meta" "$name" "$compose" <<'PY'
import json,sys,datetime
path,name,compose=sys.argv[1],sys.argv[2],sys.argv[3]
prev={}
try: prev=json.load(open(path))
except Exception: pass
doc={"name":name,"mode":"compose","compose":compose,"image":prev.get("image",""),
     "previous_image":prev.get("image"),"status":"running",
     "updated_at":datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump(doc, open(path,"w"), indent=2)
print("deployed compose", name)
PY
    return 0
  fi

  [ -n "$image" ] || ge_die "provide --image <ref> or --compose <file>"
  local public_domain host
  public_domain="$(ge_load_site_value dns.public_domain)"
  public_domain="${public_domain:-example.com}"
  host="${name}.${public_domain}"
  if [ -n "$domain" ] && [[ "$domain" == *.* ]]; then
    host="$domain"
  fi

  docker network inspect web >/dev/null 2>&1 || docker network create web
  local prev_image=""
  if [ -f "$meta" ]; then
    prev_image="$(python3 -c "import json;print(json.load(open('$meta')).get('image') or '')")"
  fi
  docker rm -f "ge-${name}" 2>/dev/null || true
  docker run -d --name "ge-${name}" --restart unless-stopped \
    --network web \
    -l "traefik.enable=true" \
    -l "traefik.http.routers.ge-${name}.rule=Host(\`${host}\`)" \
    -l "traefik.http.routers.ge-${name}.entrypoints=websecure" \
    -l "traefik.http.routers.ge-${name}.tls=true" \
    "$image"

  python3 - "$meta" "$name" "$image" "$host" "$prev_image" <<'PY'
import json,sys,datetime
path,name,image,host,prev=sys.argv[1:6]
doc={"name":name,"mode":"image","image":image,"previous_image":prev or None,
     "domain":host,"status":"running","container":f"ge-{name}",
     "updated_at":datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump(doc, open(path,"w"), indent=2)
print(f"deployed {name} → {image} ({host})")
PY
}

cmd_status() {
  cmd_node_status
  echo ""
  echo "apps:"
  cmd_deploy ls
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help|-h|--help) cmd_help ;;
    version|-V|--version) cmd_version ;;
    node)
      case "${1:-status}" in
        status) shift || true; cmd_node_status "$@" ;;
        *) ge_die "unknown node subcommand: ${1:-}" ;;
      esac
      ;;
    module|mod) cmd_module "$@" ;;
    pkg|package)
      # back-compat alias
      case "${1:-list}" in
        list) shift || true; cmd_module list ;;
        install) shift || true; cmd_module install "$@" ;;
        installed) shift || true; cmd_module installed ;;
        upgrade) shift || true; cmd_module upgrade "$@" ;;
        *) cmd_module "$@" ;;
      esac
      ;;
    catalog)
      case "${1:-build}" in
        build) shift || true; ge_catalog_build "${1:-$(ge_catalog_path)}"; echo "wrote ${1:-$(ge_catalog_path)}" ;;
        *) ge_die "usage: ge catalog build [out.yaml]" ;;
      esac
      ;;
    upgrade) ge_upgrade_kit "$@" ;;
    deploy) cmd_deploy "$@" ;;
    status) cmd_status ;;
    *) ge_die "unknown command: $cmd (try: ge help)" ;;
  esac
}

main "$@"
