{
  "version": 1,
  "purpose": "Audited request field maps for Community handlers whose mounted OpenAPI body is a loose object. Descriptive only; API remains the validation and authorization authority.",
  "operations": {
    "POST /v1/cloud/easy-connect": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "browser",
            "device"
          ],
          "default": "browser"
        },
        "return_url": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        }
      },
      "additionalProperties": true
    },
    "POST /v1/cloud/easy-connect/complete": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "code": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "POST /v1/cloud/easy-connect/{session_id}/complete": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "code": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "POST /v1/cloud/unlink": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "POST /v1/code-tasks/{run_id}/feedback": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "selected_element": {
          "type": "string"
        },
        "screenshot_url": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "default": "normal"
        }
      },
      "additionalProperties": true
    },
    "POST /v1/elastic/capacity": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "desired_workers": {
          "type": "integer",
          "description": "Desired number of workers"
        },
        "pool_key": {
          "type": "string",
          "description": "Logical pool key"
        },
        "worker_pool_id": {
          "type": "string",
          "description": "Existing pool id"
        },
        "kind": {
          "type": "string",
          "description": "Worker kind"
        },
        "provider_account_id": {
          "type": "string",
          "description": "Provider account for cloud spillover"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auto_reconcile": {
          "type": "boolean",
          "default": true
        },
        "cloud_spillover_enabled": {
          "type": "boolean",
          "default": false
        },
        "reason": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id",
        "desired_workers"
      ]
    },
    "POST /v1/elastic/instances/{instance_id}/heartbeat": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "worker"
        },
        "status": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "Worker endpoint URL"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id"
      ]
    },
    "POST /v1/elastic/instances/{instance_id}/terminate": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "reason": {
          "type": "string"
        },
        "destroy_provider_resource": {
          "type": "boolean",
          "default": false,
          "description": "Also destroy underlying cloud resource when present"
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id"
      ]
    },
    "POST /v1/elastic/pools/{worker_pool_id}/reconcile": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "cloud_spillover_enabled": {
          "type": "boolean",
          "default": false
        },
        "reason": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id"
      ]
    },
    "POST /v1/goldeneye/apps/deploy": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "name": {
          "type": "string",
          "description": "App name (stable id)"
        },
        "node_id": {
          "type": "string"
        },
        "node_name": {
          "type": "string"
        },
        "image_ref": {
          "type": "string",
          "description": "Container image reference"
        },
        "image": {
          "type": "string",
          "description": "Alias for image_ref"
        },
        "compose_ref": {
          "type": "string",
          "description": "Compose file / bundle reference"
        },
        "compose": {
          "type": "string",
          "description": "Alias for compose_ref"
        },
        "domain": {
          "type": "string",
          "description": "Public or tailnet domain for the app"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id",
        "name"
      ]
    },
    "POST /v1/goldeneye/apps/{name}/rollback": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id"
      ]
    },
    "POST /v1/goldeneye/nodes": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "description": "Project scope"
        },
        "actor": {
          "type": "string",
          "description": "Actor id (default ceo)"
        },
        "name": {
          "type": "string",
          "description": "Stable node name"
        },
        "display_name": {
          "type": "string",
          "description": "Human-readable name"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Node roles e.g. edge, control, data, app"
        },
        "public_ip": {
          "type": "string"
        },
        "tailnet_ip": {
          "type": "string"
        },
        "ssh_host": {
          "type": "string",
          "description": "SSH target host or IP"
        },
        "ssh_user": {
          "type": "string",
          "default": "root",
          "description": "SSH user"
        },
        "ssh_port": {
          "type": "integer",
          "default": 22,
          "description": "SSH port"
        },
        "kit_version": {
          "type": "string"
        },
        "site_config": {
          "type": "object",
          "additionalProperties": true
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id",
        "name"
      ]
    },
    "POST /v1/goldeneye/nodes/{node_id}/heartbeat": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "description": "Node status e.g. ready, degraded, offline"
        },
        "kit_version": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id"
      ]
    },
    "POST /v1/goldeneye/packages/install": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "package_id": {
          "type": "string",
          "description": "Package id from the Goldeneye catalog"
        },
        "node_id": {
          "type": "string",
          "description": "Target node id (preferred)"
        },
        "node_name": {
          "type": "string",
          "description": "Target node name if id unknown"
        },
        "force": {
          "type": "boolean",
          "default": false,
          "description": "Bypass bootstrap order checks (operator risk)"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id",
        "package_id"
      ]
    },
    "POST /v1/provider-usage/ingest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "system"
        },
        "provider": {
          "type": "string",
          "description": "Provider key e.g. aws, azure"
        },
        "operation": {
          "type": "string",
          "description": "Operation name e.g. bedrock.converse"
        },
        "category": {
          "type": "string",
          "default": "api_call"
        },
        "quantity": {
          "type": "number",
          "default": 1
        },
        "unit": {
          "type": "string",
          "default": "count"
        },
        "provider_account_id": {
          "type": "string"
        },
        "cost_usd_micros": {
          "type": "integer",
          "description": "Cost in micro-USD"
        },
        "resource_ref": {
          "type": "string"
        },
        "worker_instance_id": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "default": "control_plane"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id",
        "provider",
        "operation"
      ]
    },
    "POST /v1/provider-usage/sync": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "default": "ceo"
        },
        "provider_account_id": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "required": [
        "project_id",
        "provider_account_id"
      ]
    },
    "POST /v1/work-trackers/connect": {
      "type": "object",
      "required": [
        "project_id",
        "provider_key"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "provider_key": {
          "type": "string",
          "enum": [
            "plane",
            "jira",
            "linear",
            "github_issues",
            "azure_devops"
          ]
        },
        "configuration": {
          "type": "object"
        },
        "api_token": {
          "type": "string"
        },
        "set_as_default": {
          "type": "boolean"
        },
        "test": {
          "type": "boolean",
          "default": true
        },
        "actor": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "POST /v1/work-trackers/set-default": {
      "type": "object",
      "required": [
        "project_id",
        "provider_key"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "provider_key": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "POST /v1/work-trackers/test": {
      "type": "object",
      "required": [
        "project_id",
        "provider_key"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "provider_key": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
