#!/usr/bin/env python3
"""An `ssh` that plays a deployment host for the end-to-end harness.

BOSS deploys by running commands on a host over ssh (deploy_service._ssh): unpack a tarball,
`docker run` the app, then poll `curl -w '%{http_code}' http://localhost:<port>/` until it
answers. A real host for a test means a VM with sshd and Docker — too much to stand up on every
run, and on boss-1 there were no deployment hosts at all, so every template that ends in
`deploy` failed at the last step after a human approved it. This stub answers the way a healthy
host does, records every command at the fakes' /deploy/ssh, and lets the deploy code path run
unchanged. Only ever first on PATH inside the harness's own services.
"""
from __future__ import annotations

import json
import os
import re
import sys
import urllib.error
import urllib.request
import uuid
from pathlib import Path


def _fakes_url() -> str:
    url = os.environ.get("BOSS_E2E_FAKES_URL", "")
    if not url:
        marker = Path.home() / ".boss-e2e-fakes-url"
        url = marker.read_text().strip() if marker.exists() else ""
    return url.rstrip("/")


def _remote_command(argv: list[str]) -> tuple[str, str]:
    """(destination, command) from an ssh argv."""
    takes_value = set("BbcDEeFIiJLlmOopQRSWw")
    i, positional = 0, []
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("-") and len(arg) >= 2 and not positional:
            flag = arg[1]
            if flag in takes_value and len(arg) == 2:
                i += 2
                continue
            i += 1
            continue
        positional.append(arg)
        i += 1
    dest = positional[0] if positional else ""
    return dest, " ".join(positional[1:])


def _curl_from_backend(fakes: str, dest: str, command: str):
    """curl on the host to one of its own ports, when the test registered a real app process for
    this host (fakes POST /_app_backend): the body and the -w write-out, as curl prints them.
    None when no app is registered, so the canned answers below still apply."""
    m = re.search(r"\bcurl\b.*?'?(https?://(?:127\.0\.0\.1|localhost)(?::\d+)?(/[^\s']*)?)", command)
    if not m:
        return None
    host = dest.split("@")[-1].split(":")[0]
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(f"{fakes}/_app_backend/{host}", timeout=5) as resp:
            backend = json.loads(resp.read() or b"{}").get("url")
    except Exception:  # noqa: BLE001 — none registered
        return None
    if not backend:
        return None
    try:
        with opener.open(backend + (m.group(2) or "/"), timeout=10) as resp:
            code, body = resp.status, resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        code, body = exc.code, exc.read().decode("utf-8", "replace")
    except Exception:  # noqa: BLE001 — curl's own word for a refused port
        code, body = 0, ""
    write = re.search(r"-w\s+'([^']*)'", command) or re.search(r'-w\s+"([^"]*)"', command)
    out = "" if re.search(r"-o\s*/dev/null", command) else body
    if write:
        out += write.group(1).replace("\\n", "\n").replace("%{http_code}", f"{code:03d}")
    return out


def main() -> int:
    argv = sys.argv[1:]
    if argv[:1] == ["-V"]:
        print("OpenSSH_9.9 boss-e2e stub", file=sys.stderr)
        return 0
    dest, command = _remote_command(argv)
    received = 0
    if "-n" not in argv and not sys.stdin.isatty():
        try:
            received = len(sys.stdin.buffer.read())
        except Exception:  # noqa: BLE001
            received = 0
    url = _fakes_url()
    if url:
        try:
            request = urllib.request.Request(
                f"{url}/deploy/ssh", method="POST",
                data=json.dumps({"dest": dest, "command": command[:4000],
                                 "stdin_bytes": received}).encode(),
                headers={"Content-Type": "application/json"})
            urllib.request.urlopen(request, timeout=10).read()
        except Exception:  # noqa: BLE001 — the record is best-effort; the answer is not
            pass
    served = _curl_from_backend(url, dest, command) if url else None
    if served is not None:
        sys.stdout.write(served)
    elif "BOSS_SSH_OK" in command:
        # deployment_fleet._connection_probe: reachable, docker present, the box's arch.
        print("BOSS_SSH_OK\nDOCKER_OK\nx86_64")
    elif re.search(r"curl\b.*http_code", command):
        sys.stdout.write("200")
    elif re.search(r"docker\s+(run|create)\b", command):
        print(uuid.uuid4().hex)
    elif re.search(r"docker\s+(ps|inspect)\b", command):
        print("running")
    elif re.search(r"\b(uname|arch)\b", command):
        print("x86_64")
    elif "docker version" in command or "docker info" in command:
        print("27.0.0")
    return 0


if __name__ == "__main__":
    sys.exit(main())
