#!/usr/bin/env python3
"""A `claude` CLI that answers from the end-to-end harness's scripted model.

BOSS drives Claude Code as a subprocess (`claude -p ... --output-format json|stream-json`) for
builds, reviews, research and typed decisions. Faking that seam in-process would skip the argv
building, the stdin fallback for long prompts, the output parsing and the turn capture — the
exact code that broke on customers before ("returned non-JSON", "Argument list too long"). So
the harness puts THIS file first on PATH and points BOSS_CLAUDE_CLI_PATH at it, and the real
code path runs against it.

It asks the model stub (BOSS_E2E_MODEL_STUB_URL, POST /_cli) for the reply. When the scripted
rule carries `files` and the call may edit (`--permission-mode acceptEdits`), it writes them into
the working directory — that is how a scripted build produces a real diff for BOSS to test,
commit and open a PR from.

It never contacts Anthropic. With no stub URL it fails loudly rather than guessing.
"""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
import uuid
from pathlib import Path

VERSION = "2.1.0 (Claude Code) [boss-e2e stub]"


def _prompt_from(argv: list[str]) -> str:
    if "--" in argv:
        return " ".join(argv[argv.index("--") + 1:])
    if "-p" in argv:
        i = argv.index("-p")
        if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            return argv[i + 1]
    if "--print" in argv:
        i = argv.index("--print")
        if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            return argv[i + 1]
    try:
        return sys.stdin.read() if not sys.stdin.isatty() else ""
    except Exception:  # noqa: BLE001 — a closed stdin is an empty prompt
        return ""


def _flag(argv: list[str], name: str, default: str = "") -> str:
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return default


def _ask_stub(prompt: str, argv: list[str]) -> dict:
    base = os.environ.get("BOSS_E2E_MODEL_STUB_URL", "").rstrip("/")
    if not base:
        # The code agent's environment is deny-by-default (agent_env.py), so the URL may not
        # survive into this process; the harness also leaves it in its scratch HOME.
        marker = Path.home() / ".boss-e2e-model-stub-url"
        base = marker.read_text().strip().rstrip("/") if marker.exists() else ""
    if not base:
        print("BOSS_E2E_MODEL_STUB_URL is not set: this is the e2e harness's fake claude, "
              "and it has no model to ask. Start it through scripts/e2e.sh.", file=sys.stderr)
        sys.exit(2)
    body = json.dumps({"prompt": prompt, "argv": argv, "cwd": os.getcwd()}).encode()
    request = urllib.request.Request(f"{base}/_cli", data=body,
                                     headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read() or b"{}")
    except (urllib.error.URLError, OSError) as exc:
        print(f"the e2e model stub at {base} did not answer: {exc}", file=sys.stderr)
        sys.exit(1)


def _write_files(files: dict, cwd: Path) -> list[str]:
    written: list[str] = []
    root = cwd.resolve()
    for rel, content in (files or {}).items():
        target = (root / rel).resolve()
        if root not in target.parents and target != root:
            continue  # a scripted path never escapes the working tree
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(str(content), encoding="utf-8")
        written.append(str(rel))
    return written


def main() -> int:
    argv = sys.argv[1:]
    if argv[:1] in (["--version"], ["-v"]):
        print(VERSION)
        return 0
    if argv[:2] == ["auth", "status"]:
        print(json.dumps({"loggedIn": True, "authMethod": "api_key",
                          "apiProvider": "boss-e2e-stub"}))
        return 0
    if argv[:1] in (["auth"], ["login"], ["logout"], ["setup-token"], ["update"], ["doctor"]):
        print("boss-e2e stub: nothing to do")
        return 0

    prompt = _prompt_from(argv)
    answer = _ask_stub(prompt, argv)
    if int(answer.get("exit_code") or 0):
        print(answer.get("stderr") or answer.get("result") or "scripted failure", file=sys.stderr)
        return int(answer["exit_code"])
    may_edit = _flag(argv, "--permission-mode") in ("acceptEdits", "bypassPermissions")
    written = _write_files(answer.get("files") or {}, Path.cwd()) if may_edit else []
    text = str(answer.get("result") or "")
    session = f"e2e-{uuid.uuid4().hex[:12]}"
    usage = {"input_tokens": max(1, len(prompt) // 4), "output_tokens": max(1, len(text) // 4),
             "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}
    result = {
        "type": "result", "subtype": "success", "is_error": False, "result": text,
        "session_id": session, "num_turns": 1 + len(written), "duration_ms": 5,
        "total_cost_usd": 0.0, "usage": usage, "model": _flag(argv, "--model", "e2e-stub"),
    }
    if _flag(argv, "--output-format") == "stream-json":
        model = result["model"]
        for i, rel in enumerate(written):
            print(json.dumps({"type": "assistant", "message": {"model": model, "content": [
                {"type": "tool_use", "id": f"tu_{i}", "name": "Write",
                 "input": {"file_path": rel}}]}}))
            print(json.dumps({"type": "user", "message": {"content": [
                {"type": "tool_result", "tool_use_id": f"tu_{i}", "content": "ok"}]}}))
        print(json.dumps({"type": "assistant", "message": {
            "model": model, "usage": usage, "content": [{"type": "text", "text": text}]}}))
        print(json.dumps(result))
    else:
        print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
