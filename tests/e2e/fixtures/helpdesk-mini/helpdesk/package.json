{
  "name": "helpdesk-mini",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "migrate": "tsx scripts/migrate.ts",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "pretest:login-oauth": "npm install --no-audit --no-fund --loglevel=error",
    "test:login-oauth": "node --test --test-reporter=junit --test-reporter-destination=boss-template-junit.xml --test-reporter=spec --test-reporter-destination=stdout tests/template_login_oauth/login.test.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-session": "1.19.0",
    "openid-client": "6.8.8",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
