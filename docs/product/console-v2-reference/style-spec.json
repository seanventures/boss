  }
 },
 "palette": {
  "canvas": "rgb(9, 13, 23)",
  "panel": "rgb(14, 20, 34)",
  "surface": "rgb(20, 27, 43)",
  "border": "rgb(30, 41, 64)",
  "ink": "rgb(230, 237, 245)",
  "muted": "rgb(141, 154, 181)",
  "dim": "rgb(90, 103, 133)",
  "mint": "rgb(79, 227, 193)"
 },
 "fonts": {
  "display": "Space Grotesk",
  "mono": "IBM Plex Mono"
 },
 "structure": {
  "/v2/hive": {
   "note": "rings with halos and dashed curves, not filled discs on one circle",
   "requires": [
    "v2-hive-graph",
    "v2-hive-halo-",
    "v2-hive-edge-"
   ],
   "computed": [
    {
     "selector": "[data-testid^='v2-hive-edge-']",
     "property": "strokeDasharray",
     "must_not_be": [
      "none",
      ""
     ],
     "why": "edges are dashed"
    },
    {
     "selector": "[data-testid^='v2-hive-node-'] circle.v2-hive-node",
     "property": "fill",
     "must_not_be": [],
     "why": "nodes are rings: dark fill, coloured stroke"
    }
   ],
   "markup": [
    {
     "pattern": "Q",
     "in_attribute": "d",
     "why": "edges are quadratic curves"
    }
   ]
  }
 }
}