# =============================================================================
# BOSS .env.example — all BOSS_* (and related) flags with comments.
# Per AGENTS.md + PRD/TECH: fail-closed defaults, no secrets committed.
# Use for local dogfood; prod uses k8s secrets/helm values + env overlays.
# See: apps/api/app/config.py, apps/worker/boss_worker/config.py,
# deploy/kubernetes/base/configmap.yaml, deploy/helm/boss/values.yaml,
# scripts/check_external_rollout_readiness.py, docs/operations/INFRA_RUNBOOK.md
# =============================================================================

# Postgres (local compose/dev only; prod: managed HA)
BOSS_POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://boss:boss@localhost:5432/boss
# Redis is an A2A transport accelerator; Postgres remains the canonical ledger.
REDIS_URL=redis://localhost:6379/0
BOSS_A2A_REDIS_PREFIX=boss:a2a
BOSS_A2A_DEFAULT_TTL_SECONDS=3600
BOSS_A2A_MAX_PAYLOAD_BYTES=65536
BOSS_A2A_DISPATCH_MAX_ATTEMPTS=5
BOSS_PIPELINE_PROVIDER=github_actions
# Non-GitHub pipeline adapters (select with BOSS_PIPELINE_PROVIDER=jenkins|gitlab).
# Tokens belong in the deployment secret store; these blank entries are documentation only.
BOSS_JENKINS_BASE_URL=
BOSS_JENKINS_USER=
BOSS_JENKINS_TOKEN=
BOSS_JENKINS_JOB=
BOSS_GITLAB_BASE_URL=https://gitlab.com
BOSS_GITLAB_TOKEN=
BOSS_GITLAB_PROJECT_ID=

# Model API keys (use official CLI/subscription first per MEB; API fallback budgeted)
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Slack (comms plane, real send gated by BOSS_SLACK_REAL_SEND_ALLOWED)
BOSS_SLACK_WEBHOOK_URL=
BOSS_MATTERMOST_BASE_URL=
BOSS_MATTERMOST_BOT_TOKEN=

# Infra / ProviderOps real provision (P0 external blocker; keep false unless ChangeSet+Budget+approval+rollback for approved rollout)
BOSS_INFRA_REAL_PROVISION_ALLOWED=false
BOSS_DIGITALOCEAN_TOKEN=
BOSS_CLOUDFLARE_API_TOKEN=
BOSS_SUPABASE_ACCESS_TOKEN=

# AWS provider adapter (Resource Plane; secret key is the provider-account SecretRef env:BOSS_AWS_SECRET_ACCESS_KEY)
BOSS_AWS_ACCESS_KEY_ID=
BOSS_AWS_SECRET_ACCESS_KEY=
BOSS_AWS_REGION=us-east-1
BOSS_AWS_ROLE_ARN=   # optional: assume this role via STS before provider calls

# Provider defaults (DO example)
BOSS_DIGITALOCEAN_DEFAULT_IMAGE=ubuntu-24-04-x64
BOSS_DIGITALOCEAN_DEFAULT_TAGS=boss,ttl-managed
BOSS_DIGITALOCEAN_VPC_UUID=
BOSS_DIGITALOCEAN_SSH_KEY_IDS=

# Email comms (real gated; SMTP details for send path)
BOSS_EMAIL_REAL_SEND_ALLOWED=false
BOSS_EMAIL_SMTP_HOST=
BOSS_EMAIL_SMTP_PORT=587
BOSS_EMAIL_SMTP_USERNAME=
BOSS_EMAIL_SMTP_PASSWORD=
BOSS_EMAIL_SMTP_USE_TLS=true
BOSS_EMAIL_SMTP_USE_SSL=false
BOSS_EMAIL_FROM_ADDRESS=
BOSS_EMAIL_FROM_NAME=

# Comms plane quiet hours + throttle (policy controlled)
BOSS_COMMS_QUIET_HOURS_ENABLED=false
BOSS_COMMS_QUIET_HOURS_START_UTC=22:00
BOSS_COMMS_QUIET_HOURS_END_UTC=07:00
BOSS_COMMS_THROTTLE_MAX_QUEUED_PER_HOUR=0
BOSS_COMMS_THROTTLE_DEFER_MINUTES=15

# Model selection + entitlement sources (CLI/OAuth first; see MEB)
BOSS_OPENAI_MODEL=gpt-5.2-codex
BOSS_OPENAI_CODEX_OAUTH_ENABLED=false
BOSS_OPENAI_CODEX_OAUTH_SESSION_REF=
BOSS_ANTHROPIC_CLAUDE_OAUTH_ENABLED=false
BOSS_ANTHROPIC_CLAUDE_OAUTH_SESSION_REF=
BOSS_XAI_GROK_OAUTH_ENABLED=false
BOSS_XAI_GROK_OAUTH_SESSION_REF=
# Conversational orchestration uses deterministic routing for explicit asks by
# default. Enable model classification only for ambiguous turns; every call is
# budget-reserved and Receipt-backed.
BOSS_AGENT_ROUTER_LLM_ENABLED=false
BOSS_AGENT_ROUTER_BUDGET_USD_MICROS=100000
BOSS_GITHUB_TOKEN=
BOSS_GITHUB_APP_ID=
BOSS_GITHUB_APP_PRIVATE_KEY=
BOSS_GITHUB_APP_PRIVATE_KEY_PATH=
BOSS_GITHUB_APP_INSTALLATION_ID=

# Durable outbound + signed inbound webhooks. Endpoint rows hold env:NAME refs;
# secret values remain in runtime secret injection, never in jobs or the database.
BOSS_WEBHOOK_TIMEOUT_SECONDS=10
BOSS_WEBHOOK_INBOUND_SECRET=
BOSS_GITHUB_WEBHOOK_SECRET=
BOSS_GITHUB_APP_BOT_LOGIN=boss[bot]
# Public PRs always receive a deterministic diff-only review. Enable the optional
# governed model pass only when community-triggered model spend is desired.
BOSS_GITHUB_COMMUNITY_MODEL_REVIEW_ENABLED=false
BOSS_GITHUB_COMMUNITY_MODEL_REVIEW_BUDGET_USD_MICROS=250000
BOSS_WEBHOOK_INBOUND_SECRETS_JSON={"github":"env:BOSS_GITHUB_WEBHOOK_SECRET"}
BOSS_WEBHOOK_PROJECT_MAP_JSON={}
# Optional BOSS-102 Go fan-out sidecar. Unset = honest not_configured; Python
# event SoR and leased webhook.outbound.deliver continue. Default dry-run.
# Do not claim s3_go_event_dispatcher live without a probe. Not Community GA.
BOSS_GO_WEBHOOK_DISPATCHER_URL=
BOSS_GO_WEBHOOK_DISPATCHER_TOKEN=
BOSS_GO_WEBHOOK_DISPATCHER_TIMEOUT_SECONDS=5
BOSS_GO_WEBHOOK_DISPATCHER_DRY_RUN=true
BOSS_CURSOR_CLI_ENABLED=false
BOSS_LOCAL_MODEL_ENABLED=false
BOSS_LOCAL_MODEL_ID=
BOSS_ENTERPRISE_MODEL_GATEWAY_ENABLED=false
BOSS_ENTERPRISE_MODEL_GATEWAY_URL=
BOSS_ENTERPRISE_MODEL_GATEWAY_TOKEN=
BOSS_ENTERPRISE_MODEL_GATEWAY_MODELS=enterprise-gateway-auto
BOSS_MANAGED_CLOUD_MODEL_GATEWAY_ENABLED=false
BOSS_MANAGED_CLOUD_MODEL_GATEWAY_MODELS=managed-cloud-gateway-auto
BOSS_CONTROL_PLANE_URL=http://127.0.0.1:8000

# Auth: API key or OIDC (BOSS_REQUIRE_API_AUTH for enforcement; OIDC for enterprise SSO)
# Non-local Community: set REQUIRE=true, rotate BOSS_API_KEYS, and bind each key
# via BOSS_API_KEY_PRINCIPALS as comma-separated api-key:member_id (or =) pairs.
# Unbound keys fail closed (401) whenever API authentication is enabled.
BOSS_REQUIRE_API_AUTH=false
BOSS_API_KEYS=
BOSS_API_KEY_PRINCIPALS=
# In Community installs the owner key binds to ceo; the distinct worker key
# binds to system. Keep both in BOSS_API_KEYS and BOSS_API_KEY_PRINCIPALS.
BOSS_WORKER_PRINCIPAL=system
BOSS_API_KEY=
BOSS_WORKER_API_KEY=

# Bootstrap seed API (local dev only; P0 security fix: default false, fail-closed 403 + denial event; enable only for make seed or explicit; requires member_manage for existing project)
BOSS_BOOTSTRAP_SEED_API_ENABLED=false

# OIDC (enterprise; requires BOSS_OIDC_ENABLED + full issuer/aud/jwks + rollout policy)
BOSS_OIDC_ENABLED=false
BOSS_OIDC_ISSUER=
BOSS_OIDC_AUDIENCE=
BOSS_OIDC_JWKS_URL=
BOSS_OIDC_PRINCIPAL_CLAIM=boss_member_id
BOSS_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
BOSS_OIDC_SUBJECT_PRINCIPALS=
BOSS_ENTERPRISE_SAML_ENABLED=false
BOSS_ENTERPRISE_SAML_SESSION_TTL_MINUTES=480
BOSS_ENTERPRISE_SAML_MEMBER_ATTRIBUTE=boss_member_id

# SAML (enterprise; BOSS_ENTERPRISE_SAML_ENABLED + active IdP record + rollout)
BOSS_ENTERPRISE_SAML_ENABLED=false
BOSS_ENTERPRISE_SAML_SESSION_TTL_MINUTES=480
BOSS_ENTERPRISE_SAML_MEMBER_ATTRIBUTE=boss_member_id

# Worker lease/poll (core durability; overridable per env)
BOSS_LEASE_TTL_SECONDS=60
BOSS_POLL_INTERVAL_SECONDS=15
BOSS_WORKER_ID=worker-local

# GitHub (for SWF sandbox + provider; real merge/deploy gated)
BOSS_GITHUB_OWNER=
BOSS_GITHUB_REPO=
BOSS_TARGET_GITHUB_OWNER=
BOSS_TARGET_GITHUB_REPO=
BOSS_GITHUB_TOKEN=

# Reactive docs agent: allowlisted completion events are entity-debounced into
# leased jobs; each job reserves this bounded model+GitHub envelope first.
BOSS_DOCS_TRIGGER_EVENTS=code_task.pr_opened,software_factory.pull_request_merged,discovery.completed
BOSS_DOCS_DEBOUNCE_SECONDS=300
BOSS_DOCS_UPDATE_BUDGET_USD_MICROS=75000

# Defaults for seed / org model (change for multi-tenant)
BOSS_DEFAULT_ORG_ID=org_boss
BOSS_DEFAULT_WORKSPACE_ID=ws_boss
BOSS_DEFAULT_PROJECT_ID=boss-dogfood
BOSS_ARTIFACTS_DIR=artifacts
BOSS_EDITION=community
BOSS_ACCOUNT_CONNECT_URL=
BOSS_ACCOUNT_CONNECT_TOKEN=
BOSS_ACCOUNT_CONNECT_TIMEOUT_SECONDS=10
BOSS_ENTERPRISE_SCIM_BEARER_TOKENS=
BOSS_CORE_PACK_ID=core_v1
# Capability bundle trust/signing. Trust keys are JSON: {"key-id":"base64-ed25519-public-key"}.
BOSS_SKILL_TRUST_KEYS={}
BOSS_SKILL_SIGNING_KEY_ID=
BOSS_SKILL_SIGNING_PRIVATE_KEY=
BOSS_EXCLUDE_UNTRUSTED_SKILLS=false
BOSS_EDITION=community

# Account Connect (hosted Cloud/Enterprise; P0 external blocker; local surfaces fail-closed without it)
BOSS_ACCOUNT_CONNECT_URL=
BOSS_ACCOUNT_CONNECT_TOKEN=
BOSS_ACCOUNT_CONNECT_TIMEOUT_SECONDS=10

# SCIM (enterprise IdP push; P0 external; fails closed unless token + active provider record)
BOSS_ENTERPRISE_SCIM_BEARER_TOKENS=

# Budget Governor (core; caps + killswitches shape all spend; Governor wins autoscaler)
BOSS_DAILY_CAP_USD_MICROS=10000000
BOSS_MONTHLY_CAP_USD_MICROS=200000000
BOSS_BURST_CAP_USD_MICROS_PER_MIN=100000
BOSS_SOFTWARE_FACTORY_PR_BUDGET_USD_MICROS=500000
BOSS_COMMS_MESSAGE_BUDGET_USD_MICROS=50000

# Real send gates (all false by default; per default_safety + resource policy)
BOSS_SLACK_REAL_SEND_ALLOWED=false
BOSS_MATTERMOST_REAL_SEND_ALLOWED=false
BOSS_EMAIL_REAL_SEND_ALLOWED=false   # (also above)
BOSS_ENABLE_SANDBOX_MERGE=false
BOSS_ENABLE_SANDBOX_DEPLOY=false

# Sandbox SWF validation + CI (for PR proposal local validation)
BOSS_SANDBOX_MERGE_METHOD=squash
BOSS_SANDBOX_DEPLOY_ENVIRONMENT=staging
BOSS_SANDBOX_DEPLOY_HEALTHCHECK_URL=
BOSS_SANDBOX_DEPLOY_HEALTHCHECK_TIMEOUT_SECONDS=10
BOSS_SANDBOX_CI_TIMEOUT_SECONDS=120
BOSS_SANDBOX_CI_POLL_INTERVAL_SECONDS=5
# How long a build waits for its PR's CI before the deploy approval (0 = no wait).
BOSS_CI_WAIT_TIMEOUT_SECONDS=1800
BOSS_SANDBOX_LOCAL_VALIDATION_ENABLED=false
BOSS_SANDBOX_VALIDATION_REPO_PATH=
BOSS_SANDBOX_VALIDATION_COMMANDS=
BOSS_SANDBOX_VALIDATION_ALLOWED_COMMANDS=pnpm,npm,node,python,python3,pytest,make
BOSS_SANDBOX_VALIDATION_TIMEOUT_SECONDS=120
BOSS_SANDBOX_VALIDATION_OUTPUT_LIMIT_CHARS=12000
BOSS_SANDBOX_VALIDATION_FETCH_REMOTE=true

# Rate limiting for high-cost control plane paths (metatron/query, commands/propose, resources/sync).
# Community / single-process: in-proc sliding window is the supported limiter (see main.py).
# Multi-replica / public-edge: front with Redis/LB/CDN; set ENABLED=false to avoid double-count.
# Code default is 120 RPM so interactive console sessions are not throttled.
BOSS_RATE_LIMIT_ENABLED=true
BOSS_RATE_LIMIT_RPM=120

# Web / client (see also apps/web/.env.example)
NEXT_PUBLIC_BOSS_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BOSS_PROJECT_ID=boss-dogfood

# Improve BOSS and the daily heartbeat (docs/product/RUN_SCORECARDS.md, Govern › Sharing).
# The heartbeat is ON by default and says only "this install is alive": a random install id,
# BOSS version and edition, install method, OS and arch, days since install (bucketed) and
# whether any work ran in the last 24h. "Improve BOSS" (content-free run outcomes and ratings)
# is OFF until an operator turns it on. Either of these turns EVERYTHING off, heartbeat included:
# BOSS_TELEMETRY=off
# DO_NOT_TRACK=1
# Where the one daily POST goes (a public collector later is a change of this value):
# BOSS_TELEMETRY_URL=   (empty: no collector, nothing is sent; or set it in Govern › Sharing)
# Proxies whose X-Forwarded-For the Improve BOSS collector believes (collector mode only; used for
# rate limits, never stored). Default: loopback only. Behind a reverse proxy on another address,
# list it, e.g. BOSS_TRUSTED_PROXIES=127.0.0.0/8,::1/128,10.0.0.5/32
# BOSS_TRUSTED_PROXIES=127.0.0.0/8,::1/128
# (The API's own uvicorn trusts forwarded headers from these same addresses and no others.)
# Proxies in front of the CONSOLE that append the client to X-Forwarded-For. Default 0: none
# ships with BOSS, so the console forwards no client claim. Behind your own TLS proxy (Caddy,
# nginx, a tunnel) that appends the client address, set 1:
# BOSS_CONSOLE_PROXY_HOPS=0

# --- Identity (docs/product/IDENTITY.md §4) ------------------------------------------------------
# The console's public origin. Session cookies, passkeys (the WebAuthn RP ID), CSRF checks and every
# emailed link use it, never a request's Host header. SET IT for any install reached from another
# machine (the installer's --console-origin writes BOSS_CONSOLE_PUBLIC_ORIGIN, which compose uses
# when this is unset). Unset, the first Owner's claim binds the secure origin their browser used
# (https, or http on localhost); with neither, BOSS sends NO emailed links and offers no passkeys or
# SSO, and Identity › Posture says so. Setup shows the URL in use.
# BOSS_PUBLIC_URL=https://boss.example.com
# PREVIEWS LIVE ON THEIR OWN ORIGIN, never the console's: a preview is someone else's app. The API
# serves preview pages (and nothing else, with every cookie stripped) on BOSS_PREVIEW_PORT; the
# console redirects any preview link there. Default: the console's host on port 3001
# (console http://localhost:3000 -> previews http://localhost:3001). Behind TLS or on another host,
# set the address a browser opens previews at. 0/off switches previews off.
# BOSS_PREVIEW_PORT=3001
# BOSS_PREVIEW_ORIGIN=https://previews.boss.example.com
# BOSS_PREVIEW_BIND=127.0.0.1
# The shared console password of an existing install: before the first Owner claims BOSS it is the
# claim credential; after, it signs in (no email) as Operator for 30 days, with a countdown on
# every page, then stops. Compose passes the same value to the console and the API.
# BOSS_CONSOLE_PASSWORD=
# Password hashing cost: default (argon2id 64 MiB) or small (19 MiB) for hosts under 2 GiB of RAM.
# BOSS_ARGON2_PROFILE=default
# Private hosts the identity outbound client may reach (a LAN Keycloak); everything else private
# (loopback, RFC 1918, link-local, metadata) is refused for OIDC discovery, JWKS and SAML metadata.
# BOSS_OUTBOUND_ALLOW_PRIVATE=keycloak.lan
# HMAC key for CSRF tokens and hashed rate-limit identifiers (32 bytes, base64). Derived from the
# vault master key when unset.
# BOSS_IDENTITY_SERVER_KEY=
# The host tools' own key (boss, boss doctor, make metatron, remote.sh): service account
# "Host tools". boss.sh issues it and writes this line; `boss identity host-key` issues a new one.
# BOSS_HOST_API_KEY=
# Access checks: enforce (default) or shadow (log what would be refused, refuse nothing).
# BOSS_AUTHZ_MODE=enforce

# --- Build sandbox (docs/community/SANDBOX.md) ----------------------------------------------------
# Every build runs as its own unprivileged uid with a fenced network (only the BOSS API and
# boss-egress). The api container starts as root with NET_ADMIN to install that fence, then drops
# to the boss user for good.
# BOSS_SANDBOX_NETWORK: enforce (default) = fence it; if this host cannot (rootless Docker, gVisor,
#   some WSL2 and VPS kernels), BOSS starts anyway, says so, and holds builds until fixed.
#   required = refuse to start without the fence. off = no fence (builds can reach this
#   container's networks; boss doctor and posture say so).
# BOSS_SANDBOX_NETWORK=enforce
# BOSS_SANDBOX_ISOLATION: required (default) = a build never runs as the API's own uid; auto =
#   isolate when possible, else run unisolated with a warning; off = never isolate.
# BOSS_SANDBOX_ISOLATION=required
