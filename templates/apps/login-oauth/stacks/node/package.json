{
  "name": "boss-template-login-oauth",
  "private": true,
  "version": "1.0.0",
  "description": "Reference implementation of the login-oauth template (Express + openid-client). Merge the dependencies and the two test:login-oauth scripts into the app's package.json.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.mjs",
    "pretest:login-oauth": "npm install --no-audit --no-fund --loglevel=error",
    "test:login-oauth": "node --test --test-reporter=junit --test-reporter-destination=boss-template-junit.xml --test-reporter=spec --test-reporter-destination=stdout tests/template_login_oauth/login.test.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-session": "1.19.0",
    "openid-client": "6.8.8"
  }
}
