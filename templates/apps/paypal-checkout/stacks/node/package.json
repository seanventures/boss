{
  "name": "boss-template-paypal-checkout",
  "private": true,
  "version": "1.0.0",
  "description": "Reference implementation of the BOSS paypal-checkout template (Express)",
  "main": "server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "pretest:template": "npm install --no-audit --no-fund --loglevel=error",
    "test:template": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=boss-template-junit.xml tests/template_paypal/paypal_checkout.test.mjs"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
