# Goldeneye production env template for BOSS.
# Copy to app.env only outside git; goldeneye fills platform values at deploy.

# Routing/domain metadata. BOSS is an admin/control-plane product, so default
# web/API routes are tailnet-only. No public raw ports are required.
APP_BASE_URL=https://boss.local.sean.network
ADMIN_URL=https://boss.local.sean.network
BOSS_ADMIN_HOSTNAME=boss.local.sean.network
BOSS_API_HOSTNAME=boss-api.local.sean.network
DEPLOY_PORTS=
BOSS_API_IMAGE=goldeneye.tail95d980.ts.net:5000/boss-api:replace-me
BOSS_WORKER_IMAGE=goldeneye.tail95d980.ts.net:5000/boss-worker:replace-me
BOSS_WEB_IMAGE=goldeneye.tail95d980.ts.net:5000/boss-web:replace-me
BOSS_ACCOUNT_CONNECT_IMAGE=goldeneye.tail95d980.ts.net:5000/boss-account-connect:replace-me

# Goldeneye-provided infrastructure.
DATABASE_URL=replace-me
REDIS_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
SENTRY_DSN=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
NEXTCLOUD_URL=
WEBDAV_URL=
CALDAV_URL=
CARDDAV_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
DOCUSEAL_URL=
DOCUSEAL_API_URL=
DOCUSEAL_TOKEN=
MAP_TILE_URL=
MAP_STYLE_URL=
ROUTING_URL=
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
POSTHOG_HOST=
POSTHOG_KEY=
N8N_URL=
N8N_WEBHOOK_URL=
MEILI_URL=
MEILI_API_KEY=
MEILI_SEARCH_KEY=
TYPEBOT_VIEWER_URL=
TYPEBOT_BUILDER_URL=
SMTP_HOST=
SMTP_PORT=587
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
KEYCLOAK_URL=
KEYCLOAK_REALM=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# BOSS control-plane auth and project defaults.
BOSS_REQUIRE_API_AUTH=true
BOSS_API_KEYS=replace-me
BOSS_API_KEY_PRINCIPALS=replace-me:ceo
BOSS_API_KEY=replace-me
BOSS_WORKER_API_KEY=replace-me
BOSS_CONTROL_PLANE_URL=http://api:8000
BOSS_DEFAULT_ORG_ID=org_boss
BOSS_DEFAULT_WORKSPACE_ID=ws_boss
BOSS_DEFAULT_PROJECT_ID=boss-dogfood
BOSS_CORE_PACK_ID=core_v1
# Local capability bundle trust/signing (Ed25519; private key is base64 raw or PEM).
BOSS_SKILL_TRUST_KEYS={}
BOSS_SKILL_SIGNING_KEY_ID=
BOSS_SKILL_SIGNING_PRIVATE_KEY=
BOSS_EXCLUDE_UNTRUSTED_SKILLS=false
BOSS_EDITION=community
BOSS_ARTIFACTS_DIR=/var/lib/boss/artifacts
# Enable only when the API runs on a trusted host with local ADB or Xcode
# Simulator tools. A Linux VM cannot run iOS Simulator actions.
BOSS_MOBILE_DEVICE_RUNNER_ENABLED=false
BOSS_BOOTSTRAP_SEED_API_ENABLED=false
BOSS_LEASE_TTL_SECONDS=300
BOSS_POLL_INTERVAL_SECONDS=15
BOSS_WORKER_ID=goldeneye-worker-1

# BOSS OIDC/SAML/enterprise settings. OIDC_* is consumed directly; BOSS_* is
# kept for existing deployments and tests.
BOSS_OIDC_ENABLED=false
BOSS_OIDC_ISSUER=
BOSS_OIDC_AUDIENCE=
BOSS_OIDC_JWKS_URL=
BOSS_OIDC_PRINCIPAL_CLAIM=boss_member_id
BOSS_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
BOSS_OIDC_SUBJECT_PRINCIPALS=
BOSS_ENTERPRISE_SAML_ENABLED=false
BOSS_ENTERPRISE_SAML_SESSION_TTL_MINUTES=480
BOSS_ENTERPRISE_SAML_MEMBER_ATTRIBUTE=boss_member_id
BOSS_ENTERPRISE_SCIM_BEARER_TOKENS=

# Model entitlement and provider routing.
BOSS_LLM_ENGINE=auto
BOSS_OPENAI_MODEL=
BOSS_PLAN_BUDGET_USD_MICROS=1500000
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
BOSS_OPENAI_CODEX_OAUTH_ENABLED=false
BOSS_OPENAI_CODEX_OAUTH_SESSION_REF=
BOSS_ANTHROPIC_CLAUDE_OAUTH_ENABLED=false
BOSS_ANTHROPIC_CLAUDE_OAUTH_SESSION_REF=
BOSS_XAI_GROK_OAUTH_ENABLED=false
BOSS_XAI_GROK_OAUTH_SESSION_REF=
BOSS_CURSOR_CLI_ENABLED=false
BOSS_LOCAL_MODEL_ENABLED=false
BOSS_LOCAL_MODEL_ID=
BOSS_ENTERPRISE_MODEL_GATEWAY_ENABLED=false
BOSS_ENTERPRISE_MODEL_GATEWAY_URL=
BOSS_ENTERPRISE_MODEL_GATEWAY_TOKEN=
BOSS_ENTERPRISE_MODEL_GATEWAY_MODELS=enterprise-gateway-auto
BOSS_MANAGED_CLOUD_MODEL_GATEWAY_ENABLED=false
BOSS_MANAGED_CLOUD_MODEL_GATEWAY_MODELS=managed-cloud-gateway-auto

# Budget Governor defaults. Adjust caps before enabling any spendy provider work.
BOSS_DAILY_CAP_USD_MICROS=10000000
BOSS_MONTHLY_CAP_USD_MICROS=200000000
BOSS_BURST_CAP_USD_MICROS_PER_MIN=100000
BOSS_SOFTWARE_FACTORY_PR_BUDGET_USD_MICROS=500000
BOSS_COMMS_MESSAGE_BUDGET_USD_MICROS=50000
BOSS_CODE_TASK_BUDGET_USD_MICROS=2000000

# ProviderOps and real external effects remain fail-closed by default.
BOSS_INFRA_REAL_PROVISION_ALLOWED=false
BOSS_DIGITALOCEAN_TOKEN=
BOSS_CLOUDFLARE_API_TOKEN=
BOSS_SUPABASE_ACCESS_TOKEN=
BOSS_SUPABASE_PROJECT_DB_PASS=
BOSS_SSH_HOST_DEPLOY_ALLOWED=false
BOSS_SSH_HOST_PRIVATE_KEY=
BOSS_DIGITALOCEAN_DEFAULT_IMAGE=ubuntu-24-04-x64
BOSS_DIGITALOCEAN_DEFAULT_TAGS=boss,ttl-managed
BOSS_DIGITALOCEAN_VPC_UUID=
BOSS_DIGITALOCEAN_SSH_KEY_IDS=

# GitHub/software-factory settings.
BOSS_GITHUB_OWNER=seanheiney
BOSS_GITHUB_REPO=boss
BOSS_TARGET_GITHUB_OWNER=seanheiney
BOSS_TARGET_GITHUB_REPO=boss-sandbox
BOSS_GITHUB_TOKEN=
BOSS_GITHUB_APP_ID=
BOSS_GITHUB_APP_PRIVATE_KEY=
BOSS_GITHUB_APP_PRIVATE_KEY_PATH=
BOSS_GITHUB_APP_INSTALLATION_ID=
BOSS_ENABLE_CODE_TASK=false
BOSS_GOVERNED_CODING_PIPELINE=false
BOSS_PIPELINE_PROFILE=balanced
BOSS_CODE_AGENT_LOW_COST_MODEL=
BOSS_CODE_AGENT_STRONG_MODEL=
BOSS_CODE_AGENT_MAX_CONCURRENCY=3
BOSS_CODE_AGENT_ENGINE=claude_code
# One-shot hop when Claude hits the org monthly spend limit. Empty + OPENAI_API_KEY => openai.
BOSS_CODE_AGENT_FAILOVER_ENGINE=
BOSS_CODE_AGENT_MAX_TURNS=40
BOSS_CODE_AGENT_TIMEOUT_SECONDS=900
BOSS_CODE_AGENT_ALLOWED_TOOLS=Read,Edit,MultiEdit,Write,Glob,Grep,Bash,TodoWrite
BOSS_SANDBOX_PROVIDER=local
BOSS_SANDBOX_AGENT_URL=http://127.0.0.1:8088
BOSS_SANDBOX_AGENT_TIMEOUT_SECONDS=1500
BOSS_SANDBOX_GUEST_ENGINE=openai
# Community GA honesty: when true, microVM execution APIs return 422 (not claimed).
# See docs/product/SANDBOX_GA_STATUS.md. Keep true until rootfs bake is proven live.
BOSS_MICROVM_CLAIMS_FROZEN=true
BOSS_SANDBOX_ROOT_PATH=
BOSS_SANDBOX_CLONE_DEPTH=1
# Operator-facing origin for preview View URLs (non-loopback). Empty = relative
# gateway path /v1/previews/{id}/web/. See docs/product/PREVIEW_GA_CHECKLIST.md.
BOSS_PREVIEW_PUBLIC_BASE=
BOSS_ENABLE_SANDBOX_MERGE=false
BOSS_ENABLE_SANDBOX_DEPLOY=false
BOSS_SANDBOX_MERGE_METHOD=squash
BOSS_SANDBOX_DEPLOY_ENVIRONMENT=staging
BOSS_SANDBOX_DEPLOY_HEALTHCHECK_URL=
BOSS_SANDBOX_DEPLOY_HEALTHCHECK_TIMEOUT_SECONDS=10
BOSS_SANDBOX_CI_TIMEOUT_SECONDS=120
BOSS_SANDBOX_CI_POLL_INTERVAL_SECONDS=5
BOSS_SANDBOX_LOCAL_VALIDATION_ENABLED=false
BOSS_SANDBOX_VALIDATION_REPO_PATH=
BOSS_SANDBOX_VALIDATION_COMMANDS=
BOSS_SANDBOX_VALIDATION_ALLOWED_COMMANDS=pnpm,npm,npx,yarn,node,python,python3,pip,pip3,uv,pytest,tox,make,cmake,ctest,mvn,mvnw,gradle,gradlew,java,javac,kotlin,go,cargo,rustc,dotnet,ruby,bundle,rake,php,composer,bazel
BOSS_SANDBOX_VALIDATION_TIMEOUT_SECONDS=120
BOSS_SANDBOX_VALIDATION_OUTPUT_LIMIT_CHARS=12000
BOSS_SANDBOX_VALIDATION_FETCH_REMOTE=true

# Comms. Goldeneye injects SMTP_* / MAIL_FROM; BOSS_* aliases remain supported.
BOSS_SLACK_WEBHOOK_URL=
BOSS_SLACK_REAL_SEND_ALLOWED=false
BOSS_EMAIL_REAL_SEND_ALLOWED=false
BOSS_EMAIL_SMTP_HOST=
BOSS_EMAIL_SMTP_PORT=587
BOSS_EMAIL_SMTP_USERNAME=
BOSS_EMAIL_SMTP_PASSWORD=
BOSS_EMAIL_SMTP_USE_TLS=true
BOSS_EMAIL_SMTP_USE_SSL=false
BOSS_EMAIL_FROM_ADDRESS=
BOSS_EMAIL_FROM_NAME=
BOSS_COMMS_QUIET_HOURS_ENABLED=false
BOSS_COMMS_QUIET_HOURS_START_UTC=22:00
BOSS_COMMS_QUIET_HOURS_END_UTC=07:00
BOSS_COMMS_THROTTLE_MAX_QUEUED_PER_HOUR=0
BOSS_COMMS_THROTTLE_DEFER_MINUTES=15

# Account Connect is optional for Community. Enable the compose profile and set
# these only when running the hosted/attached Account Connect service locally on goldeneye.
BOSS_ACCOUNT_CONNECT_URL=
BOSS_ACCOUNT_CONNECT_TOKEN=
BOSS_ACCOUNT_CONNECT_TIMEOUT_SECONDS=10
AC_DATABASE_URL=
AC_SERVICE_TOKEN=
AC_PUBLIC_BASE_URL=
AC_DEFAULT_ORG_ID=org_boss_cloud
AC_DEFAULT_ORG_NAME=BOSS Cloud

# High-cost route limiter. Production should also use reverse-proxy/edge limits.
BOSS_RATE_LIMIT_ENABLED=true
BOSS_RATE_LIMIT_RPM=10

# Web runtime.
NEXT_PUBLIC_BOSS_API_URL=https://boss-api.local.sean.network
NEXT_PUBLIC_BOSS_PROJECT_ID=boss-dogfood
NEXT_PUBLIC_BOSS_API_KEY=
