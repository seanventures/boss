# Secrets written by the installer into the install directory. An in-place install
# (./install.sh --dir "$PWD", as the README shows) puts them inside this checkout.
.env
.env.*
!.env.example
app.env
boss-community.env.sh
*.pem

# Python
.venv/
.venv*/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / web
node_modules
.next/
*.tsbuildinfo
coverage/
dist/

# Docs build, local state, editors
site/
.local-logs/
tmp/
.DS_Store
.idea/
.vscode/

# The installed release record (written by the installer; not a local change)
.boss-release
# BOSS fixes itself: the self-source mirror, the stack worktree, the self-installer's key
/.boss/

# Artifacts the API writes under the checkout when run or tested in place (settings.artifact_root)
/artifacts/
